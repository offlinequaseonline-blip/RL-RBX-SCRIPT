local function learningEnabled()
	return Toggles.AutoLearn ~= nil and Toggles.AutoLearn.Value == true
end

local function unitValue(value)
	if type(value) ~= "number" or value ~= value then return 0 end
	return math.clamp(value, -1, 1)
end

local function countValue(value)
	if type(value) ~= "number" or value ~= value then return 0 end
	return math.clamp(math.floor(value), 0, 1000000)
end

local function modeProfile(mode)
	local key = tostring(math.clamp(mode or 1, 1, 3))
	local profile = learningData.modes[key]
	if type(profile) ~= "table" then
		profile = {}
		learningData.modes[key] = profile
	end
	if type(profile.actions) ~= "table" then profile.actions = {} end
	for _, action in { "shot", "pass", "challenge", "airDribble", "waveDash", "speedFlip" } do
		local metric = profile.actions[action]
		if type(metric) ~= "table" then
			metric = { samples = 0, average = 0 }
			profile.actions[action] = metric
		end
		metric.samples = countValue(metric.samples)
		metric.average = unitValue(metric.average)
	end
	profile.opponentPressure = math.clamp(tonumber(profile.opponentPressure) or 0, 0, 1)
	profile.pressureSamples = countValue(profile.pressureSamples)
	profile.teamCommitRate = math.clamp(tonumber(profile.teamCommitRate) or 0, 0, 1)
	profile.opponentCommitRate = math.clamp(tonumber(profile.opponentCommitRate) or 0, 0, 1)
	profile.coordinationSamples = countValue(profile.coordinationSamples)
	profile.peerTouchSamples = countValue(profile.peerTouchSamples)
	profile.peerTouchQuality = unitValue(profile.peerTouchQuality)
	profile.peerAerialSamples = countValue(profile.peerAerialSamples)
	profile.peerAerialQuality = unitValue(profile.peerAerialQuality)
	profile.peerPassSamples = countValue(profile.peerPassSamples)
	profile.peerPassLead = math.clamp(tonumber(profile.peerPassLead) or 0.35, 0.1, 3)
	profile.peerPassQuality = unitValue(profile.peerPassQuality)
	profile.peerPassMisses = countValue(profile.peerPassMisses)
	profile.ownPassSamples = countValue(profile.ownPassSamples)
	profile.ownPassLead = math.clamp(tonumber(profile.ownPassLead) or 0.35, 0.1, 3)
	profile.ownPassQuality = unitValue(profile.ownPassQuality)
	profile.ownPassMisses = countValue(profile.ownPassMisses)
	learnedDoubleCommitRate[tonumber(key)] = profile.teamCommitRate
	return profile
end

for _, mode in { 1, 2, 3 } do
	local profile = learningData.modes[tostring(mode)]
	if type(profile) == "table" then
		learnedDoubleCommitRate[mode] = math.clamp(tonumber(profile.teamCommitRate) or 0, 0, 1)
	end
end

local function saveLearning()

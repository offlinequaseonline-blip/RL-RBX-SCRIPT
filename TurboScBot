---------------------------------------------------------------- live sim
-- live = { cars = {{car, team, index}}, ball, pads, tick, me = entry } of whichever sim stepped last
local live
local lastMatchAt = -1
local TICK = 1 / 120
local path = {} -- predicted ball {pos, t} every PATH_STRIDE ticks
local PATH_STRIDE = 4
local ballPred = BallPrediction.new()

local function fromMatch(P)
	local m = P.match
	local cars = {}
	for _, e in m.cars do
		if not e.vacant then table.insert(cars, e) end
	end
	return { source = "match", cars = cars, ball = m.ball, pads = m.pads and m.pads.pads or {}, tick = m.tick, me = P.localIndex and m.cars[P.localIndex] }
end
local function fromWorld(w)
	local me = { car = w.car, team = 0, index = 1 }
	return { source = "world", cars = { me }, ball = w.ball, pads = w.pads and w.pads.pads or {}, tick = w.tick, me = me }
end

-- Blox League-style read-only view of a car, so the control code below ports verbatim
local function stateOf(car)
	local b = car.body
	return {
		pos = b.pos, vel = b.vel, angVel = b.angVel, rot = { forward = b.fwd, right = b.right, up = b.up },
		boost = car.boost, isOnGround = car.isOnGround, isFlipping = car.isFlipping,
		hasFlipped = car.hasFlipped, hasDoubleJumped = car.hasDoubleJumped, isDemoed = car.isDemoed,
	}
end

local function predictBall(seconds)
	table.clear(path)
	if not live then return end
	ballPred:run(live.ball, seconds, PATH_STRIDE)
	for i = 2, #ballPred.points do
		table.insert(path, { pos = ballPred.points[i], t = ballPred.times[i] })
	end
end

---------------------------------------------------------------- control helpers (signs from Sim.Car)
-- steer/yaw + turns toward rot.right, pitch + = nose up, roll + tilts up toward rot.right
-- rates: pitch = -w·right, yaw = w·up, roll = -w·forward
local UP = vector.create(0, 0, 1)
local function clamp1(x) return math.clamp(x, -1, 1) end
local function flat(v) return vector.create(v.x, v.y, 0) end
local function angleTo(rot, dir)
	return math.atan2(vector.dot(dir, rot.right), vector.dot(dir, rot.forward))
end

local function now() return (live and live.tick or 0) * TICK end

local function orient(c, st, f)
	local rot, w = st.rot, st.angVel
	local eRoll = math.atan2(vector.dot(UP, rot.right), vector.dot(UP, rot.up))
	local ePitch = math.atan2(vector.dot(f, rot.up), vector.dot(f, rot.forward))
	local eYaw = math.atan2(vector.dot(f, rot.right), vector.dot(f, rot.forward))
	c.roll = clamp1(3 * eRoll + 0.6 * vector.dot(w, rot.forward))
	c.pitch = clamp1(3.5 * ePitch + 0.8 * vector.dot(w, rot.right))
	c.yaw = clamp1(3.5 * eYaw - 0.8 * vector.dot(w, rot.up))
end
local function recover(c, st, heading)
	local h = heading or flat(st.rot.forward)
	if vector.magnitude(h) < 1 then h = vector.create(0, 1, 0) end
	orient(c, st, vector.normalize(h))
end

local maneuver -- active {kind, t0, pitch, yaw, ...}
local lastJumpInput = false
local lastGroundJumpAt
local controlSource, controlTick
local kickoffAssist = { armed = false, locked = false }
local autoFlipReadyAt, halfFlipReadyAt, aerialReadyAt, strikeReadyAt, flickReadyAt, waveDashReadyAt, wallShotReadyAt = 0, 0, 0, 0, 0, 0, 0

local function resetControlState()
	maneuver, lastJumpInput, lastGroundJumpAt = nil, false, nil
	kickoffAssist.armed, kickoffAssist.locked = false, false
	autoFlipReadyAt, halfFlipReadyAt, aerialReadyAt, strikeReadyAt, flickReadyAt, waveDashReadyAt, wallShotReadyAt = 0, 0, 0, 0, 0, 0, 0
end

local function bestBallTarget(st)
	local best, bestDistance, bestTime
	for _, pt in path do
		local carFuture = st.pos + st.vel * pt.t
		local distance = vector.magnitude(pt.pos - carFuture)
		if not bestDistance or distance < bestDistance then
			best, bestDistance, bestTime = pt.pos, distance, pt.t
		end
	end
	return best, bestTime, bestDistance
end

local function startDodge(st, target, kind, full3D)
	if maneuver or not st.isOnGround then return false end
	local dir = target - st.pos
	if not full3D then dir = flat(dir) end
	if vector.magnitude(dir) < 1 then dir = flat(st.rot.forward) end
	if vector.magnitude(dir) < 1 then return false end
	local a = angleTo(st.rot, dir)
	local p, y = -math.cos(a), math.sin(a)
	local m = math.max(math.abs(p), math.abs(y))
	if m < 1e-6 then return false end
	local heading = flat(st.rot.forward)
	if vector.magnitude(heading) < 1 then heading = vector.create(0, 1, 0) end
	maneuver = {
		kind = kind or "flip", t0 = now(), pitch = p / m, yaw = y / m,
		heading = vector.normalize(heading), sawFlip = false,
	}
	return true
end

local function startWaveDash(st, target)
	if maneuver or st.isOnGround or st.isFlipping or st.hasFlipped or st.hasDoubleJumped then return false end
	local dir = flat(target - st.pos)
	if vector.magnitude(dir) < 1 then return false end
	local a = angleTo(st.rot, dir)
	local p, y = -math.cos(a), math.sin(a)
	local m = math.max(math.abs(p), math.abs(y))
	if m < 1e-6 then return false end
	maneuver = { kind = "waveDash", t0 = now(), pitch = p / m, yaw = y / m, released = false }
	return true
end

local function startHalfFlip(st)
	if not startDodge(st, st.pos - st.rot.forward * 100, "halfFlip") then return false end
	maneuver.heading = -maneuver.heading
	return true
end

local function startFastAerial(st, target)
	target = target or bestBallTarget(st)
	if not target or target.z - st.pos.z < Options.AerialHeight.Value or st.boost <= 0 then return false end
	maneuver = { kind = "fastAerial", t0 = now(), target = target, wasAirborne = false }
	return true
end

local function runManeuver(c, st)
	local m = maneuver
	if not m then return false end
	local dt = now() - m.t0
	if dt < 0 then maneuver = nil return false end

	if m.kind == "waveDash" then
		if st.isOnGround or dt > Options.WaveDashDuration.Value then
			maneuver = nil
			c.jump = false
			return true
		end
		if not m.released then
			m.released = true
			c.jump = false
			return true
		end
		c.throttle, c.jump = 1, true
		c.pitch, c.yaw, c.roll = m.pitch, m.yaw, 0
		return true
	end

	if m.kind == "fastAerial" then
		if st.isOnGround and m.wasAirborne then maneuver = nil return false end
		if not st.isOnGround then m.wasAirborne = true end
		local target = bestBallTarget(st)
		if target then m.target = target end
		if dt > 2 or vector.magnitude(m.target - st.pos) < 120 then maneuver = nil return false end
		c.throttle, c.boost = 1, st.boost > 0
		recover(c, st, m.target - st.pos)
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		elseif dt < 0.2 and not st.hasDoubleJumped then
			c.jump = true
		else
			c.jump = false
		end
		return true
	end

	if m.kind == "halfFlip" then
		if dt > 0.9 then maneuver = nil return false end
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		elseif dt < 0.2 then
			c.jump, c.pitch, c.yaw, c.roll = true, m.pitch, m.yaw, 0
		else
			c.jump, c.throttle = false, 1
			recover(c, st, m.heading)
			if st.rot.up.z > 0.75 and vector.dot(flat(st.rot.forward), m.heading) > 0.7 then maneuver = nil end
		end
		return true
	end

	if m.kind == "speedFlip" then
		if dt > 0.9 then maneuver = nil return false end
		c.throttle, c.boost = 1, st.boost > 0
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		elseif dt < 0.2 then
			c.jump, c.pitch, c.yaw, c.roll = true, m.pitch, m.yaw, 0
		else
			c.jump, c.throttle, c.boost = false, 1, st.boost > 0
			c.pitch, c.yaw, c.roll = -m.pitch, m.yaw, 0
			if st.isFlipping then m.sawFlip = true elseif m.sawFlip then maneuver = nil end
		end
		return true
	end

	if m.kind == "flip" or m.kind == "shot" or m.kind == "clear" or m.kind == "flick" or m.kind == "wallShot" then
		if dt > 0.22 then maneuver = nil return false end
		if m.kind == "clear" then c.throttle, c.boost = 1, st.boost > 0 end
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		else
			c.jump, c.pitch, c.yaw, c.roll = true, m.pitch, m.yaw, 0
		end
		return true
	end

	maneuver = nil
	return false
end

local function nearBall(st, within)
	local b = path[math.max(1, math.floor(0.15 / (PATH_STRIDE * TICK)))]
	if not b or st.rot.up.z < 0.7 then return nil end
	local d = b.pos - (st.pos + st.vel * 0.15)
	if b.pos.z > 220 or math.abs(d.z) > 200 then return nil end
	local fwd, side = vector.dot(d, st.rot.forward), vector.dot(d, st.rot.right)
	if vector.magnitude(flat(d)) < within and fwd > -40 and math.abs(side) < 130 then return b.pos end
end

local function teammateCloser(st, target, interceptTime)
	local me = live and live.me
	if not me or me.team == nil then return false end
	local t = interceptTime or 0
	local myFuture = st.pos + st.vel * t
	local myDistance = vector.magnitude(flat(target - myFuture))
	for _, e in live.cars do
		if e ~= me and e.team == me.team and e.car and not e.car.isDemoed then
			local other = stateOf(e.car)
			local distance = vector.magnitude(flat(target - (other.pos + other.vel * t)))
			if distance + Options.TeammateMargin.Value < myDistance then return true end
		end
	end
	return false
end

local function attackDirection()
	local me = live and live.me
	if not me then return nil end
	-- RocketSim Soccar convention: team 0/Blue starts at -Y and attacks +Y.
	local sign = me.team == 0 and 1 or me.team == 1 and -1 or nil
	if not sign then return nil end
	if Toggles.InvertAttackDirection.Value then sign = -sign end
	return vector.create(0, sign, 0)
end

local function strikeOpportunity(st)
	local ball = live and live.ball and live.ball.body
	local attack = attackDirection()
	local impact = nearBall(st, Options.FlipRange.Value)
	if not ball or not attack or not impact then return nil end
	local fwd, side = vector.dot(impact - (st.pos + st.vel * 0.15), st.rot.forward),
		vector.dot(impact - (st.pos + st.vel * 0.15), st.rot.right)
	local forward = flat(st.rot.forward)
	if fwd <= 0 or math.abs(side) > Options.ShotLineTolerance.Value or vector.magnitude(forward) < 1 then return nil end
	if vector.dot(vector.normalize(forward), attack) < Options.ShotAlignment.Value then return nil end
	local progress = vector.dot(impact, attack)
	local incoming = vector.dot(ball.vel, attack) < -Options.ClearIncomingSpeed.Value
	local kind = progress < -Options.ClearDepth.Value and incoming and "clear" or "shot"
	return impact, attack, kind
end

local function dribbleSetup(st)
	local ball = live and live.ball and live.ball.body
	if not ball or not st.isOnGround or st.rot.up.z < 0.7 then return false end
	local relative = ball.pos - st.pos
	local front = vector.dot(relative, st.rot.forward)
	local side = vector.dot(relative, st.rot.right)
	local height = vector.dot(relative, st.rot.up)
	local relativeSpeed = vector.magnitude(ball.vel - st.vel)
	return front >= 0 and front <= Options.FlickFrontMax.Value
		and math.abs(side) <= Options.FlickSideMax.Value
		and height >= Options.FlickHeightMin.Value and height <= Options.FlickHeightMax.Value
		and relativeSpeed <= Options.FlickRelativeSpeed.Value
end

local function timeToGround(st)
	-- Defaults match RocketSim GRAVITY_Z=-650 and CAR_SPAWN_REST_Z=17; both are tunable for this game's build.
	local height = st.pos.z - Options.WaveDashGroundZ.Value
	if height <= 0 then return 0 end
	local gravity = Options.WaveDashGravity.Value
	local discriminant = st.vel.z * st.vel.z + 2 * gravity * height
	return (st.vel.z + math.sqrt(discriminant)) / gravity
end

local function wallShotOpportunity(st)
	if not st.isOnGround or st.rot.up.z <= -0.7 or st.rot.up.z >= 0.7 then return nil end
	local ball = live and live.ball and live.ball.body
	if not ball then return nil end
	local relative = ball.pos - (st.pos + st.vel * 0.1)
	local forward = vector.dot(relative, st.rot.forward)
	local side = vector.dot(relative, st.rot.right)
	if forward <= 0 or math.abs(side) > Options.WallShotSide.Value
		or vector.magnitude(relative) > Options.WallShotRange.Value then return nil end
	local target = st.pos + st.rot.forward * forward + st.rot.right * side
	return target
end


uiFlow.scoreGapFromHud = function()
	local playerGui = LP:FindFirstChildOfClass("PlayerGui")
	local camera = workspace.CurrentCamera
	if not playerGui or not camera then return nil end
	local size = camera.ViewportSize
	local mid = size.X * 0.5
	local rows = {}
	for _, item in playerGui:GetDescendants() do
		if item:IsA("TextLabel") and uiFlow.guiIsVisible(item, playerGui) then
			local valueText = tostring(item.Text or ""):match("^%s*(%d+)%s*$")
			local value = valueText and tonumber(valueText)
			if value and value <= 99 then
				local position = item.AbsolutePosition + item.AbsoluteSize * 0.5
				if position.Y <= size.Y * 0.18 and position.X >= size.X * 0.3 and position.X <= size.X * 0.7 then
					local row = math.floor(position.Y / math.max(12, size.Y * 0.018) + 0.5)
					local entry = rows[row] or { y = position.Y }
					if position.X < mid then
						local distance = math.abs(position.X - size.X * 0.42)
						if not entry.leftDistance or distance < entry.leftDistance then entry.left, entry.leftDistance = value, distance end
					else
						local distance = math.abs(position.X - size.X * 0.58)
						if not entry.rightDistance or distance < entry.rightDistance then entry.right, entry.rightDistance = value, distance end
					end
					rows[row] = entry
				end
			end
		end
	end
	local bestLeft, bestRight, bestY = nil, nil, math.huge
	for _, row in rows do
		if row.left ~= nil and row.right ~= nil then
			local distance = math.abs(row.y - size.Y * 0.06)
			if distance < bestY then bestLeft, bestRight, bestY = row.left, row.right, distance end
		end
	end
	if bestLeft == nil or bestRight == nil then return nil end
	local team = live and live.me and live.me.team
	if team ~= 0 and team ~= 1 then return nil end
	local localTeamIsLeft = team == 0
	if Toggles.InvertScoreboardSides and Toggles.InvertScoreboardSides.Value then
		localTeamIsLeft = not localTeamIsLeft
	end
	return localTeamIsLeft and bestLeft - bestRight or bestRight - bestLeft
end

uiFlow.buttonContext = function(button)
	local parts = { button.Name }
	if button:IsA("TextButton") then table.insert(parts, button.Text) end
	for _, child in button:GetDescendants() do
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			table.insert(parts, child.Name)
			table.insert(parts, child.Text)
		end
	end
	local node = button.Parent
	local depth = 0
	while node and depth < 6 do
		table.insert(parts, node.Name)
		if node:IsA("TextLabel") or node:IsA("TextButton") then table.insert(parts, node.Text) end
		node = node.Parent
		depth += 1
	end
	local lower = string.lower(table.concat(parts, " "))
	return lower:gsub("[%s%p_]+", "")
end


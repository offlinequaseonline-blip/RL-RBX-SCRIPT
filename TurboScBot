local UP = vector.create(0, 0, 1)
local function clamp1(x) return math.clamp(x, -1, 1) end
local function flat(v) return vector.create(v.x, v.y, 0) end
local function kickoffPaused(ball)
	return ball ~= nil and vector.magnitude(flat(ball.pos)) < 2 and vector.magnitude(flat(ball.vel)) < 5
end
local function angleTo(rot, dir)
	return math.atan2(vector.dot(dir, rot.right), vector.dot(dir, rot.forward))
end

local function shouldPowerSlide(st, angle, distance)
	if not Toggles.AutoPowerslide or not Toggles.AutoPowerslide.Value then return false end
	if not Options.PowerslideMinSpeed or vector.magnitude(flat(st.vel)) < Options.PowerslideMinSpeed.Value then return false end
	if not Options.PowerslideSteer then return false end
	if math.abs(angle) < Options.PowerslideSteer.Value then return false end
	return distance == nil or not Options.PowerslideMinDistance or distance >= Options.PowerslideMinDistance.Value
end

local maneuver
local teamRoleLock = { yielding = false, candidate = nil, candidateSince = 0 }

local function applyDriftCorrection(c, st)
	if not Toggles.AutoDriftCorrection or not Toggles.AutoDriftCorrection.Value
		or not st.isOnGround or st.isFlipping or maneuver or st.rot.up.z < 0.75 then return false end
	local forward, velocity = flat(st.rot.forward), flat(st.vel)
	local speed = vector.magnitude(velocity)
	if speed < 320 or vector.magnitude(forward) < 1 then return false end
	local forwardSpeed = vector.dot(velocity, vector.normalize(forward))
	local lateralSpeed = vector.dot(velocity, st.rot.right)
	if forwardSpeed < 0 or math.abs(lateralSpeed) < Options.DriftCorrectionThreshold.Value then return false end
	local angle = angleTo(st.rot, velocity)
	c.steer = clamp1(angle / (math.pi / 2))
	c.throttle = math.min(c.throttle, 0.45)
	c.boost, c.handbrake = false, false
	return true
end

local function now() return (live and live.tick or 0) * TICK end

local function orient(c, st, f)
	local rot, w = st.rot, st.angVel
	local eRoll = math.atan2(vector.dot(UP, rot.right), vector.dot(UP, rot.up))
	local ePitch = math.atan2(vector.dot(f, rot.up), vector.dot(f, rot.forward))
	local eYaw = math.atan2(vector.dot(f, rot.right), vector.dot(f, rot.forward))
	c.roll = clamp1(3 * eRoll + 0.6 * vector.dot(w, rot.forward))
	c.pitch = clamp1(3.5 * ePitch + 0.8 * vector.dot(w, rot.right))
	c.yaw = clamp1(3.5 * eYaw - 0.8 * vector.dot(w, rot.up))
end
local function recover(c, st, heading)
	local h = heading or flat(st.rot.forward)
	if vector.magnitude(h) < 1 then h = vector.create(0, 1, 0) end
	orient(c, st, vector.normalize(h))
end


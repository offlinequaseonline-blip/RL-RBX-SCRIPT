	teleportFailedConn:Disconnect()
	conn:Disconnect()
	if Prediction.step == wrappedPStep then Prediction.step = origPStep end
	if World.step == wrappedWStep then World.step = origWStep end
	for _, d in lines do d:Remove() end
	for _, d in texts do d:Remove() end
	landing:Remove()
end)


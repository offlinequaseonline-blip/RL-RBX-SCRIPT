function guiFallback.draw()
	if not guiFallback.ensureOverlay() then return end
	local lineCount = 0
	if Toggles.BallPath.Value and live and live.ball and #path > 1 then
		local color = Options.PathColor.Value
		local previous, previousOn = screen(live.ball.body.pos)
		for _, point in path do
			local current, currentOn = screen(point.pos)
			if currentOn and previousOn then
				lineCount += 1
				local segment = guiFallback.getLine(lineCount)
				if segment then
					local delta = current - previous
					segment.Position = UDim2.fromOffset(previous.X, previous.Y)
					segment.Size = UDim2.fromOffset(delta.Magnitude, 2)
					segment.Rotation = math.deg(math.atan2(delta.Y, delta.X))
					segment.BackgroundColor3 = color
					segment.Visible = true
				end
			end
			previous, previousOn = current, currentOn
		end
	end
	for index = lineCount + 1, #guiFallback.lines do
		if guiFallback.lines[index] then guiFallback.lines[index].Visible = false end
	end
	if not guiFallback.landing then
		guiFallback.landing = Instance.new("Frame")
		guiFallback.landing.Name = "BallLanding"
		guiFallback.landing.AnchorPoint = Vector2.new(0.5, 0.5)
		guiFallback.landing.Size = UDim2.fromOffset(24, 24)
		guiFallback.landing.BackgroundTransparency = 1
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = guiFallback.landing
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Parent = guiFallback.landing
		guiFallback.landing.Parent = guiFallback.gui
	end
	guiFallback.landing.Visible = false
	if Toggles.BallPath.Value and live and live.ball and #path > 1 then
		for _, point in path do
			if point.pos.z < 110 then
				local position, on = screen(point.pos)
				if on then
					guiFallback.landing.Position = UDim2.fromOffset(position.X, position.Y)
					guiFallback.landing.Visible = true
					local stroke = guiFallback.landing:FindFirstChildOfClass("UIStroke")
					if stroke then stroke.Color = Options.PathColor.Value end
				end
				break
			end
		end
	end
	local me = live and live.me
	local textCount = 0
	if live and Toggles.BoostESP.Value then
		for _, entry in live.cars do
			if entry ~= me and entry.car and not entry.car.isDemoed and entry.car.body then
				local position, on = screen(entry.car.body.pos + vector.create(0, 0, 90))
				if on then
					textCount += 1
					local label = guiFallback.getText(textCount)
					if label then
						label.Text = string.format("%d", math.max(0, math.floor(tonumber(entry.car.boost) or 0)))
						label.TextColor3 = (me and entry.team == me.team)
							and Color3.fromRGB(90, 170, 255) or Color3.fromRGB(255, 110, 60)
						label.Position = UDim2.fromOffset(position.X, position.Y)
						label.Visible = true
					end
				end
			end
		end
	end
	for index = textCount + 1, #guiFallback.texts do
		if guiFallback.texts[index] then guiFallback.texts[index].Visible = false end
	end
end

function guiFallback.drawingAvailable()
	if guiFallback.drawingSupported then return true end
	if os.clock() < guiFallback.nextDrawingProbeAt then return false end
	guiFallback.nextDrawingProbeAt = os.clock() + 1
	guiFallback.drawingSupported = text(1) ~= nil
	return guiFallback.drawingSupported
end

local function draw()
	if not guiFallback.drawingAvailable() then
		guiFallback.draw()
		return
	end
	if guiFallback.gui then guiFallback.gui.Enabled = false end
	local n = 0
	ensureBaseDrawings()
	if landing then landing.Visible = false end
	if Toggles.BallPath.Value and live and live.ball and #path > 1 then
		local col = Options.PathColor.Value
		local prev, prevOn = screen(live.ball.body.pos)
		for _, pt in path do
			local s, on = screen(pt.pos)
			if on and prevOn then
				n += 1
				local l = line(n)
				if l then l.From, l.To, l.Color, l.Visible = prev, s, col, true end
			end
			prev, prevOn = s, on
		end
		for _, pt in path do
			if pt.pos.z < 110 then
				local s, on = screen(pt.pos)
				if on and landing then
					landing.Position, landing.Radius, landing.Color, landing.Visible = s, 12, col, true
				end
				break
			end
		end
	end
	local me = live and live.me
	if live and Toggles.BoostESP.Value then
		local m = 0
		for _, e in live.cars do
			if e ~= me and e.car and not e.car.isDemoed and e.car.body then
				local point, on = screen(e.car.body.pos + vector.create(0, 0, 90))
				if on then
					m += 1
					local t = text(m)
					if t then
						local boost = math.max(0, math.floor(tonumber(e.car.boost) or 0))
						t.Text = string.format("%d", boost)
						t.Color = (me and e.team == me.team)
							and Color3.fromRGB(90, 170, 255) or Color3.fromRGB(255, 110, 60)
						t.Position, t.Visible = point, true
					end
				end
			end
		end
		for i = m + 1, #texts do if texts[i] then texts[i].Visible = false end end
	else
		for _, t in texts do if t then t.Visible = false end end
	end
	for i = n + 1, #lines do if lines[i] then lines[i].Visible = false end end
end


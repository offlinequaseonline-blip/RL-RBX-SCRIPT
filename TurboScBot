local nx = { action = {0,0,0,0,0,0,0,0}, nextTick = 0, job = nil, kick = -1, lastGround = {}, spent = 0, deadline = 0 }

local function nxArena()
	local cars, me = {}, nil
	for _, e in live.cars do
		local w = { team = e.team, id = e.index, GetState = function() return stateOf(e.car) end }
		table.insert(cars, w)
		if e == live.me then me = w end
	end
	local ball = live.ball.body
	return {
		cars = cars, boostPads = live.pads,
		ball = { GetState = function() return { pos = ball.pos, vel = ball.vel, angVel = ball.angVel } end },
	}, me
end

local function kickoffTaker(arena, me)
	local ball = arena.ball:GetState().pos
	local function d(car) return vector.magnitude(flat(car:GetState().pos - ball)) end
	local mine, minD = d(me), math.huge
	for _, car in arena.cars do minD = math.min(minD, d(car)) end
	if math.abs(minD - mine) > 10 then return false end
	local mx = me:GetState().pos.x
	for _, car in arena.cars do
		if car ~= me and car.team == me.team and math.abs(d(car) - mine) <= 10 then
			local ox = car:GetState().pos.x
			local lateralTie = math.abs(ox - mx) <= 10
			local isLeft = me.team == 0 and ox < mx or me.team == 1 and ox > mx
			if lateralTie then
				if car.id == nil or me.id == nil or car.id < me.id then return false end
			elseif not isLeft then
				return false
			end
		end
	end
	return true
end

local NX_BUDGET = 0.004
if NX then
	NX.step = function()
		if os.clock() > nx.deadline then coroutine.yield() end
	end
end
local nextoWasEnabled = false
local function nextoControls(c, st)
	if not NX then error("Nexto isn't loaded (see the earlier warning)") end
	local tick = live.tick
	local arena, me
	if nx.pads ~= live.pads then nx.pads, nx.padMap = live.pads, nil end
	if not nx.job and tick >= nx.nextTick then
		nx.nextTick = tick + 8
		arena, me = nxArena()
		local q, kv = NX.buildObs(arena, me, tick, nx)
		nx.job = coroutine.create(function() return NX:forward(q, kv) end)
	end
	if nx.job and nx.spent < NX_BUDGET then
		local t0 = os.clock()
		nx.deadline = t0 + NX_BUDGET - nx.spent
		local ok, best = coroutine.resume(nx.job)
		nx.spent += os.clock() - t0
		if not ok then nx.job = nil error(best) end
		if coroutine.status(nx.job) == "dead" then
			nx.job = nil
			nx.action = NX.ACTIONS[best]
			nx.lastBest = best
		end
	end
	local a = nx.action
	local ball = live.ball.body
	local kickoffPause = ball.pos.x == 0 and ball.pos.y == 0 and vector.magnitude(ball.vel) == 0
	if kickoffPause then
		local speed = vector.magnitude(st.vel)
		if speed < 5 then nx.kickArmed = true end
		if nx.kickTick == nil then
			if not arena then arena, me = nxArena() end
			nx.kick = kickoffTaker(arena, me) and 0 or -2
			if nx.kickArmed and speed > 5 then nx.kickTick = nx.kick == 0 and tick or false end
		end
		if nx.kick >= 0 then
			if nx.kickTick then nx.kick = tick - nx.kickTick end
			if NX.KICKOFF[nx.kick + 1] then a = NX.KICKOFF[nx.kick + 1] nx.action = a end
		end
	else
		nx.kick, nx.kickTick, nx.kickArmed = -1, nil, false
	end
	c.throttle, c.steer, c.pitch, c.yaw, c.roll = a[1], a[2], a[3], a[4], a[5]
	c.jump, c.boost, c.handbrake = a[6] > 0, a[7] > 0, a[8] > 0
end

local function drive(c)
	local me = live.me
	if not me then resetControlState() return end
	if Library.Unloaded then return end
	if controlSource ~= live.source or (controlTick and live.tick < controlTick) then
		resetControlState()
		nx.job, nx.action, nx.nextTick = nil, {0,0,0,0,0,0,0,0}, live.tick
		nx.kick, nx.kickTick, nx.kickArmed = -1, nil, false
	end
	controlSource, controlTick = live.source, live.tick
	local st = stateOf(me.car)
	if nextoWasEnabled ~= Toggles.NextoBot.Value then
		nextoWasEnabled = Toggles.NextoBot.Value
		nx.job, nx.action, nx.nextTick = nil, {0,0,0,0,0,0,0,0}, live.tick
		nx.kick, nx.kickTick, nx.kickArmed = -1, nil, false
		resetControlState()
	end
	if Toggles.NextoBot.Value then
		local ok = pcall(nextoControls, c, st)
		if not ok then
			nx.job = nil
		end
		return
	end

	local userJump = c.jump == true
	local jumpPressed = userJump and not lastJumpInput
	lastJumpInput = userJump
	if st.isOnGround and jumpPressed then lastGroundJumpAt = now() end
	local ball = live.ball and live.ball.body
	local kickoffPause = ball and ball.pos.x == 0 and ball.pos.y == 0 and vector.magnitude(ball.vel) == 0
	local speed = vector.magnitude(st.vel)
	if kickoffPause and speed < 5 then kickoffAssist.armed = true end
	if Toggles.AutoSpeedFlip.Value and kickoffAssist.armed and not kickoffAssist.locked and speed > adaptiveKickoffStartSpeed() then
		kickoffAssist.locked = true
		if st.isOnGround then
			local arena, kickoffMe = nxArena()
			if kickoffMe and kickoffTaker(arena, kickoffMe) then
				local side = st.pos.x >= ball.pos.x and 1 or -1
				local target = st.pos + flat(st.rot.forward) * 100 + flat(st.rot.right) * (100 * side)
				startDodge(st, target, "speedFlip")
			end
		end
	end
	if not kickoffPause then
		kickoffAssist.armed, kickoffAssist.locked = false, false
	end

	local intercept, interceptTime, interceptDistance = bestBallTarget(st)
	local aerialRange = adaptiveAerialRange()
	local forward, toIntercept = flat(st.rot.forward), intercept and flat(intercept - st.pos)
	local behindBall = false
	if intercept and toIntercept and vector.magnitude(toIntercept) > Options.FlipRange.Value
		and vector.magnitude(toIntercept) < Options.HalfFlipRange.Value
		and vector.magnitude(forward) > 1 and vector.magnitude(toIntercept) > 1 then
		behindBall = vector.dot(vector.normalize(forward), vector.normalize(toIntercept)) < -0.55
	end
	local manualHalfFlip = jumpPressed and c.throttle < -0.5
	if not maneuver and Toggles.AutoHalfFlip.Value and st.isOnGround and st.rot.up.z > 0.7 and now() >= halfFlipReadyAt
		and manualHalfFlip and startHalfFlip(st) then
		halfFlipReadyAt = now() + 1.2
	end
	if not maneuver and jumpPressed and Toggles.AutoFlick.Value and st.isOnGround and now() >= flickReadyAt
		and dribbleSetup(st) then
		local forward, attack = flat(st.rot.forward), attackDirection()
		local aim = attack and vector.dot(vector.normalize(forward), attack) > 0.5 and attack or forward
		if startDodge(st, st.pos + aim * 100, "flick") then flickReadyAt = now() + 0.8 end
	end
	if not maneuver and Toggles.AutoStrike.Value and st.isOnGround and now() >= strikeReadyAt and c.throttle > 0.4 then
		local impact, attack, kind = strikeOpportunity(st)
		if impact and not teammateCloser(st, impact, 0.15)
			and startDodge(st, st.pos + attack * 100, kind) then
			strikeReadyAt = now() + 1.0
		end
	end
	local contextualHalfFlip = c.throttle > 0.4 and behindBall and intercept
		and not teammateCloser(st, intercept, interceptTime)
	if not maneuver and Toggles.AutoHalfFlip.Value and st.isOnGround and st.rot.up.z > 0.7 and now() >= halfFlipReadyAt
		and contextualHalfFlip and startHalfFlip(st) then
		halfFlipReadyAt = now() + 1.2
	end
	if not maneuver and Toggles.AutoFastAerial.Value and st.isOnGround and st.rot.up.z > 0.7 and now() >= aerialReadyAt
		and intercept and interceptTime <= Options.AerialMaxTime.Value
		and interceptDistance <= aerialRange
		and intercept.z - st.pos.z >= Options.AerialHeight.Value
		and st.boost > 0 and c.throttle > -0.3
		and not teammateCloser(st, intercept, interceptTime) then
		if startFastAerial(st, intercept) then aerialReadyAt = now() + 2.5 end
	end
	if not maneuver and Toggles.AutoFlip.Value and st.isOnGround and now() >= autoFlipReadyAt then
		local b = nearBall(st, Options.FlipRange.Value)
		if b and c.throttle > -0.3 and not teammateCloser(st, b, 0.15) and startDodge(st, b, "flip") then
			autoFlipReadyAt = now() + 0.9
		end
	end
	if not maneuver and Toggles.AutoWaveDash.Value and not st.isOnGround and not st.isFlipping
		and not st.hasFlipped and not st.hasDoubleJumped and not c.boost and st.rot.up.z > 0.85
		and st.vel.z < -80 and vector.magnitude(flat(st.vel)) >= Options.WaveDashMinSpeed.Value
		and lastGroundJumpAt and now() - lastGroundJumpAt <= Options.WaveDashJumpWindow.Value
		and now() >= waveDashReadyAt then
		local landingTime = timeToGround(st)
		if landingTime >= 0 and landingTime <= adaptiveWaveDashLead() then
			local direction = flat(st.vel)
			if vector.magnitude(direction) < 1 then direction = flat(st.rot.forward) end
			if startWaveDash(st, st.pos + direction * 100) then waveDashReadyAt = now() + 0.4 end
		end
	end
	if not maneuver and Toggles.AutoWallShot.Value and st.isOnGround and now() >= wallShotReadyAt and c.throttle > 0.2 then
		local target = wallShotOpportunity(st)
		if target and not teammateCloser(st, target, 0.1) and startDodge(st, target, "wallShot", true) then
			wallShotReadyAt = now() + 0.9
		end
	end

	if maneuver then
		local enabled = (maneuver.kind == "flip" and Toggles.AutoFlip.Value)
			or ((maneuver.kind == "shot" or maneuver.kind == "clear") and Toggles.AutoStrike.Value)
			or (maneuver.kind == "flick" and Toggles.AutoFlick.Value)
			or (maneuver.kind == "wallShot" and Toggles.AutoWallShot.Value)
			or (maneuver.kind == "halfFlip" and Toggles.AutoHalfFlip.Value)
			or (maneuver.kind == "speedFlip" and Toggles.AutoSpeedFlip.Value)
			or (maneuver.kind == "fastAerial" and Toggles.AutoFastAerial.Value)
			or (maneuver.kind == "waveDash" and Toggles.AutoWaveDash.Value)
		if not enabled then maneuver = nil end
	end
	if runManeuver(c, st) then return end
	if Toggles.AutoAirFollow.Value and not st.isOnGround and not st.isFlipping and c.boost
		and math.abs(c.pitch) + math.abs(c.yaw) + math.abs(c.roll) < 0.1
		and intercept and interceptTime <= Options.AerialMaxTime.Value
		and interceptDistance <= aerialRange and st.boost > 0
		and not teammateCloser(st, intercept, interceptTime) then
		recover(c, st, intercept - st.pos)
		c.boost = true
		return
	end

	if Toggles.AutoPowerslide.Value and st.isOnGround and st.rot.up.z > 0.7 and c.throttle > 0.2
		and math.abs(c.steer) >= Options.PowerslideSteer.Value then
		c.handbrake = true
	end
	local idleAir = math.abs(c.pitch) + math.abs(c.yaw) + math.abs(c.roll) < 0.1
	if Toggles.AutoRecover.Value and idleAir and not st.isOnGround and not st.isFlipping then
		local v = flat(st.vel)
		recover(c, st, vector.magnitude(v) > 300 and v or nil)
	end
end

local actionCategory = {
	shot = "shot", clear = "shot",
	flip = "challenge", fastAerial = "challenge", halfFlip = "challenge",
	flick = "challenge", wallShot = "challenge",
	speedFlip = "speedFlip", waveDash = "waveDash",
}

local function beginLearningTrial(activeManeuver)
	local category = actionCategory[activeManeuver.kind]
	local me = live and live.me
	local ball = live and live.ball and live.ball.body
	if not category or not me or not ball then return nil end
	local state = stateOf(me.car)
	return {
		maneuver = activeManeuver,
		category = category,
		mode = detectedTeamSize(),
		tick = live.tick,
		ballVelocity = ball.vel,
		attack = attackDirection(),
		distance = vector.magnitude(flat(ball.pos - state.pos)),
		speed = vector.magnitude(flat(state.vel)),
	}
end

local function finishLearningTrial(trial)
	if not live or live.source ~= "match" or live.tick < trial.tick then return end
	local me = live.me
	local ball = live.ball and live.ball.body
	if not me or not ball then return end
	local state = stateOf(me.car)
	local reward
	if trial.category == "shot" and trial.attack then
		local before = vector.dot(trial.ballVelocity, trial.attack)
		local after = vector.dot(ball.vel, trial.attack)
		reward = unitValue((after - before) / math.max(math.abs(before), math.abs(after), 1))
	elseif trial.category == "waveDash" or trial.category == "speedFlip" then
		local speed = vector.magnitude(flat(state.vel))
		reward = unitValue((speed - trial.speed) / math.max(trial.speed, 1))
	else
		local distance = vector.magnitude(flat(ball.pos - state.pos))
		reward = unitValue((trial.distance - distance) / math.max(trial.distance, 1))
	end
	local metric = modeProfile(trial.mode).actions[trial.category]
	metric.samples += 1
	local rate = 1 / math.min(metric.samples, 8)
	metric.average = unitValue(metric.average + (reward - metric.average) * rate)
	learningDirty = true
end

local function observeOpponentPressure()
	if os.clock() - lastOpponentSampleAt < 0.5 then return end
	lastOpponentSampleAt = os.clock()
	local me = live and live.me
	local ball = live and live.ball and live.ball.body
	if not me or not ball or me.team == nil then return end
	local ownDistance, opponentDistance = math.huge, math.huge
	for _, entry in live.cars do
		if entry.car and not entry.car.isDemoed then
			local distance = vector.magnitude(flat(ball.pos - entry.car.body.pos))
			if entry.team == me.team then
				ownDistance = math.min(ownDistance, distance)
			elseif entry.team ~= nil then
				opponentDistance = math.min(opponentDistance, distance)
			end
		end
	end
	if ownDistance == math.huge or opponentDistance == math.huge then return end
	local profile = modeProfile(detectedTeamSize())
	profile.pressureSamples += 1
	local rate = 1 / math.min(profile.pressureSamples, 8)
	local observedPressure = opponentDistance < ownDistance and 1 or 0
	profile.opponentPressure += (observedPressure - profile.opponentPressure) * rate
	learningDirty = true
end

local function updateLearning()
	if not learningEnabled() or not live or live.source ~= "match" then
		learningTrial = nil
		return
	end
	observeOpponentPressure()
	local current = maneuver
	if learningTrial and live.tick < learningTrial.tick then learningTrial = nil end
	if learningTrial and current ~= learningTrial.maneuver then
		finishLearningTrial(learningTrial)
		learningTrial = nil
	end
	if not learningTrial and current then learningTrial = beginLearningTrial(current) end
	if learningDirty and os.clock() - lastLearningSaveAt >= 30 then
		saveLearning()
		lastLearningSaveAt = os.clock()
	end
end

local origPStep, origWStep = Prediction.step, World.step
local wrappedPStep
wrappedPStep = function(self, controls, ...)
	lastMatchAt = os.clock()
	live = fromMatch(self)
	if controls and self.match.phase == "play" then
		drive(controls)
		Protocol.quantize(controls)
	end
	pcall(updateLearning)
	return origPStep(self, controls, ...)
end
Prediction.step = wrappedPStep
local wrappedWStep
wrappedWStep = function(self, ...)
	if os.clock() - lastMatchAt > 0.25 then
		if Motion.atMenu() then
			live = nil
			resetControlState()
			nx.job = nil
		else
			live = fromWorld(self)
			drive(self.car.controls)
		end
	end
	return origWStep(self, ...)
end

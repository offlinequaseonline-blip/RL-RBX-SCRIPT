local function adaptiveShotAlignment()
	local value = Options.ShotAlignment.Value
	if not learningEnabled() then return value end
	local profile = modeProfile(detectedTeamSize())
	local metric = profile.actions.shot
	if metric.samples >= 3 then value -= metric.average * 0.05 end
	if profile.peerTouchSamples >= 8 then value -= profile.peerTouchQuality * 0.02 end
	return math.clamp(value, 0.5, 0.98)
end

local function adaptiveAerialRange()
	local value = Options.AerialRange.Value
	if not learningEnabled() then return value end
	local profile = modeProfile(detectedTeamSize())
	local challenge = profile.actions.challenge
	if challenge.samples >= 3 then value += challenge.average * 75 end
	if profile.peerAerialSamples >= 3 then value += profile.peerAerialQuality * 70 end
	if profile.pressureSamples >= 8 then value += (profile.opponentPressure - 0.5) * 100 end
	return math.clamp(value, 250, 2200)
end

local function applyAirInterceptControls(c, st, target, interceptTime, interceptDistance, force)
	if not Toggles.AutoAirIntercept or not Toggles.AutoAirIntercept.Value
		or st.isOnGround or st.isFlipping or maneuver or not target or not interceptTime or not interceptDistance then return false end
	if interceptTime > math.min(Options.AerialMaxTime.Value, 1.15)
		or interceptDistance > math.min(adaptiveAerialRange(), 900) or st.boost <= 0 then return false end
	if not force and teammateCloser(st, target, interceptTime) then return false end
	local delta = target - st.pos
	local planar = flat(delta)
	if vector.magnitude(delta) < 110 then return false end
	local angle = vector.magnitude(planar) > 1 and math.abs(angleTo(st.rot, planar)) or 0
	recover(c, st, delta)
	c.throttle, c.jump, c.handbrake = 1, false, false
	c.boost = st.boost > 0 and interceptDistance > 170 and interceptTime < 0.95 and angle < 1.05
	return true
end

local function applyAerialDodge(c, st, target, interceptTime, interceptDistance, force)
	if not Toggles.AutoAerialDodge or not Toggles.AutoAerialDodge.Value
		or st.isOnGround or st.isFlipping or maneuver or st.hasFlipped or st.hasDoubleJumped
		or not target or not interceptTime or not interceptDistance or now() < cooldown.airDodge then return false end
	if interceptTime > Options.AerialDodgeWindow.Value or interceptDistance > Options.AerialDodgeRange.Value then return false end
	if not force and teammateCloser(st, target, interceptTime) then return false end
	if not startAerialDodge(st, target) then return false end
	cooldown.airDodge = now() + 2.0
	return runManeuver(c, st)
end

local function adaptiveWaveDashLead()
	local value = Options.WaveDashLead.Value
	if learningEnabled() then
		local movement = modeProfile(detectedTeamSize()).actions.waveDash
		if movement.samples >= 3 then value += movement.average * 0.02 end
	end
	return math.clamp(value, 0.03, 0.2)
end

local function adaptiveKickoffStartSpeed()
	local value = 5
	if learningEnabled() then
		local speedFlip = modeProfile(detectedTeamSize()).actions.speedFlip
		if speedFlip.samples >= 3 then value -= speedFlip.average * 2 end
	end
	return math.clamp(value, 2, 10)
end

local function passOpportunity(impact)
	if not Toggles.AutoPass or not Toggles.AutoPass.Value or detectedTeamSize() < 2 then return nil end
	local me = live and live.me
	local attack = attackDirection()
	if not me or me.team == nil or not attack then return nil end
	local profile = modeProfile(detectedTeamSize())
	local minProgress = Options.PassMinProgress.Value - profile.opponentCommitRate * 120
	local maxRange = Options.PassMaxRange.Value
	local clearance = Options.PassLaneClearance.Value
	local bestTarget, bestScore, bestReceiverIndex
	for _, receiver in live.cars do
		if receiver ~= me and receiver.team == me.team and receiver.car and not receiver.car.isDemoed then
			local receiverState = stateOf(receiver.car)
			local receiverLead = profile.ownPassSamples >= 3 and profile.ownPassLead
				or profile.peerPassSamples >= 3 and profile.peerPassLead or Options.PassLeadTime.Value
			local target = receiverState.pos + receiverState.vel * receiverLead
			local route = flat(target - impact)
			local distance = vector.magnitude(route)
			local progress = vector.dot(route, attack)
			if distance >= 220 and distance <= maxRange and progress >= minProgress and progress / distance >= 0.2 then
				local routeLengthSquared = vector.dot(route, route)
				local laneBlocked, receiverOccupied = false, false
				local receiverSpace = math.huge
				local receiverFacing = 0
				local receiverForward = flat(receiverState.rot.forward)
				local receiverToBall = flat(impact - target)
				if vector.magnitude(receiverForward) > 1 and vector.magnitude(receiverToBall) > 1 then
					receiverFacing = vector.dot(vector.normalize(receiverForward), vector.normalize(receiverToBall))
				end
				local receiverMomentum = vector.magnitude(receiverToBall) > 1
					and vector.dot(flat(receiverState.vel), vector.normalize(receiverToBall)) or 0
				for _, opponent in live.cars do
					if opponent ~= me and opponent ~= receiver and opponent.team == me.team and opponent.car and not opponent.car.isDemoed then
						local otherState = stateOf(opponent.car)
						local otherFuture = otherState.pos + otherState.vel * receiverLead
						if vector.magnitude(flat(target - otherFuture)) < clearance then receiverOccupied = true end
					elseif opponent.team ~= nil and opponent.team ~= me.team and opponent.car and not opponent.car.isDemoed then
						local opponentState = stateOf(opponent.car)
						local futureOpponent = opponentState.pos + opponentState.vel * math.min(receiverLead, 0.4)
						local along = math.clamp(vector.dot(flat(futureOpponent - impact), route) / routeLengthSquared, 0, 1)
						local lanePoint = impact + route * along
						if vector.magnitude(flat(futureOpponent - lanePoint)) < clearance then laneBlocked = true end
						receiverSpace = math.min(receiverSpace, vector.magnitude(flat(target - futureOpponent)))
					end
				end
				if not laneBlocked and not receiverOccupied then
					local score = progress - distance * 0.18 + math.min(receiverSpace, 500) * 0.12
						+ receiverFacing * 90 + math.clamp(receiverMomentum, -500, 500) * 0.08
					if not bestScore or score > bestScore then bestTarget, bestScore, bestReceiverIndex = target, score, receiver.index end
				end
			end
		end
	end
	return bestTarget, bestReceiverIndex
end

local function shotLaneBlocked(impact, attack)
	local me = live and live.me
	if not me or not attack then return false end
	for _, entry in live.cars do
		if entry ~= me and entry.team ~= nil and entry.team ~= me.team and entry.car and not entry.car.isDemoed then
			local other = stateOf(entry.car)
			local future = flat(other.pos + other.vel * 0.35 - impact)
			local along = vector.dot(future, attack)
			if along > 100 and along <= Options.ShotLaneRange.Value then
				local lateral = vector.magnitude(future - attack * along)
				if lateral <= Options.ShotLaneClearance.Value then return true end
			end
		end
	end
	return false
end

local function openClearDirection(impact, attack)
	local lateral = vector.create(attack.y, -attack.x, 0)
	local bestDirection, bestScore = attack, -math.huge
	for _, side in { 0, 1, -1 } do
		local direction = side == 0 and attack or vector.normalize(attack + lateral * side * 0.6)
		local clearance = 800
		for _, entry in live.cars do
			if entry ~= live.me and entry.team ~= nil and entry.team ~= live.me.team
				and entry.car and not entry.car.isDemoed then
				local opponent = entry.car.body
				local relative = flat(opponent.pos + opponent.vel * 0.45 - impact)
				local along = vector.dot(relative, direction)
				if along > 0 and along < 900 then
					local closest = impact + direction * along
					clearance = math.min(clearance, vector.magnitude(flat(opponent.pos + opponent.vel * 0.45 - closest)))
				end
			end
		end
		local score = math.min(clearance, 800) - (side == 0 and 0 or 90)
		if score > bestScore then bestDirection, bestScore = direction, score end
	end
	return bestDirection
end

local function openShotDirection(impact, attack)
	local lateral = vector.create(attack.y, -attack.x, 0)
	local bestDirection, bestScore = attack, -math.huge
	for _, offset in { 0, 0.22, -0.22, 0.42, -0.42 } do
		local direction = offset == 0 and attack or vector.normalize(attack + lateral * offset)
		local clearance = Options.ShotLaneRange.Value
		for _, entry in live.cars do
			if entry ~= live.me and entry.team ~= nil and entry.team ~= live.me.team
				and entry.car and not entry.car.isDemoed then
				local opponent = entry.car.body
				local relative = flat(opponent.pos + opponent.vel * 0.35 - impact)
				local along = vector.dot(relative, direction)
				if along > 100 and along <= Options.ShotLaneRange.Value then
					local closest = impact + direction * along
					clearance = math.min(clearance, vector.magnitude(flat(opponent.pos + opponent.vel * 0.35 - closest)))
				end
			end
		end
		local score = math.min(clearance, Options.ShotLaneClearance.Value * 3) - math.abs(offset) * 190
		if score > bestScore then bestDirection, bestScore = direction, score end
	end
	return bestDirection
end

local function applyAirRedirectControls(c, st, target, interceptTime, interceptDistance, force)
	if not Toggles.AutoAirRedirect or not Toggles.AutoAirRedirect.Value or st.isOnGround
		or st.isFlipping or maneuver or not target or not interceptTime or not interceptDistance then return false end
	if interceptTime > Options.AirRedirectWindow.Value or interceptDistance > Options.AirRedirectRange.Value
		or (not force and teammateCloser(st, target, interceptTime)) then return false end
	local attack = attackDirection()
	local ball = live and live.ball and live.ball.body
	if not attack or not ball then return false end
	local direction = attack
	local progress = vector.dot(flat(target), attack)
	local towardOwnGoal = -vector.dot(flat(ball.vel), attack)
	if progress < -Options.ClearDepth.Value and towardOwnGoal > Options.ClearIncomingSpeed.Value then
		direction = openClearDirection(target, attack)
	else
		local shotDirection = shotLaneBlocked(target, attack) and openShotDirection(target, attack) or attack
		if not shotLaneBlocked(target, shotDirection) then
			direction = shotDirection
		elseif not aggressiveLeadMode and Toggles.AutoAirPass and Toggles.AutoAirPass.Value then
			local passTarget, receiverIndex = passOpportunity(target)
			local passDirection = passTarget and flat(passTarget - target) or nil
			if passDirection and vector.magnitude(passDirection) > 100 then
				direction = vector.normalize(passDirection)
				airActions.passActive = true
				airActions.passLearningAction.targetDirection = direction
				airActions.passLearningAction.targetPosition = passTarget
				airActions.passLearningAction.receiverIndex = receiverIndex
			else
				direction = Toggles.AutoSideClear and Toggles.AutoSideClear.Value
					and openClearDirection(target, attack) or attack
			end
		else
			direction = Toggles.AutoSideClear and Toggles.AutoSideClear.Value
				and openClearDirection(target, attack) or attack
		end
	end
	local redirectPoint = target + direction * Options.AirRedirectDistance.Value
	local delta = redirectPoint - st.pos
	local planar = flat(delta)
	if vector.magnitude(planar) < 1 then return false end
	local angle = math.abs(angleTo(st.rot, planar))
	local interceptDirection = vector.normalize(delta)
	local closingSpeed = vector.dot(st.vel - ball.vel, interceptDirection)
	recover(c, st, delta)
	c.throttle, c.jump, c.handbrake = math.clamp(interceptDistance / 260, 0.45, 1), false, false
	c.boost = st.boost > 0 and interceptDistance > 140
		and closingSpeed < Options.AirDribbleMaxClosing.Value and angle < 0.95
	return true
end

local function applyShotApproachControls(c, st, intercept, interceptDistance)
	if maneuver or not Toggles.AutoStrike.Value or not st.isOnGround or not intercept or not attackDirection() then return false end
	if not interceptDistance or interceptDistance > 500 then return false end
	local attack = attackDirection()
	if shotLaneBlocked(intercept, attack) then
		if not Toggles.AutoAimOpenLane or not Toggles.AutoAimOpenLane.Value then return false end
		attack = openShotDirection(intercept, attack)
		if shotLaneBlocked(intercept, attack) then return false end
	end
	local forward = flat(st.rot.forward)
	if vector.magnitude(forward) < 0.01 then return false end
	local alignment = vector.dot(vector.normalize(forward), attack)
	if alignment >= 0.72 then return false end
	local setup = flat(intercept) - attack * Options.ShotApproachOffset.Value
	local direction = flat(setup - st.pos)
	local distance = vector.magnitude(direction)
	if distance < 90 or distance > 360 then return false end
	local angle = angleTo(st.rot, direction)
	c.throttle = math.clamp(distance / 300, 0.25, 0.75)
	c.steer = clamp1(angle / (math.pi / 2))
	c.jump = false
	c.boost = st.boost > 25 and distance > 280 and math.abs(angle) < 0.25
	c.handbrake = shouldPowerSlide(st, angle, distance)
	return true
end

local function strikeOpportunity(st, forceAttack)
	local ball = live and live.ball and live.ball.body
	local attack = attackDirection()
	local impact = nearBall(st, Options.FlipRange.Value)
	if not ball or not attack or not impact then return nil end
	local fwd, side = vector.dot(impact - (st.pos + st.vel * 0.15), st.rot.forward),
		vector.dot(impact - (st.pos + st.vel * 0.15), st.rot.right)
	local forward = flat(st.rot.forward)
	if fwd <= 0 or math.abs(side) > Options.ShotLineTolerance.Value or vector.magnitude(forward) < 1 then return nil end
	local progress = vector.dot(impact, attack)
	local incoming = vector.dot(ball.vel, attack) < -Options.ClearIncomingSpeed.Value
	if Toggles.AutoStrike.Value and progress < -Options.ClearDepth.Value and incoming then
		local clearDirection = Toggles.AutoSideClear and Toggles.AutoSideClear.Value and openClearDirection(impact, attack) or attack
		return impact, clearDirection, "clear"
	end
	local passTarget, passReceiverIndex = passOpportunity(impact)
	if forceAttack then
		if passTarget and (not Toggles.AutoStrike or not Toggles.AutoStrike.Value) then
			return impact, nil, "pass", passTarget, passReceiverIndex
		end
		if Toggles.AutoStrike and Toggles.AutoStrike.Value then
			local forcedDirection = Toggles.AutoAimOpenLane and Toggles.AutoAimOpenLane.Value
				and openShotDirection(impact, attack) or attack
			if shotLaneBlocked(impact, forcedDirection) then
				if passTarget then return impact, nil, "pass", passTarget, passReceiverIndex end
				return nil
			end
			return impact, forcedDirection, "shot"
		end
		return nil
	end
	local blocked = shotLaneBlocked(impact, attack)
	local shotDirection = blocked and Toggles.AutoAimOpenLane and Toggles.AutoAimOpenLane.Value
		and openShotDirection(impact, attack) or attack
	local shotClear = not shotLaneBlocked(impact, shotDirection)
	local shotAlignment = vector.dot(vector.normalize(forward), shotDirection)
	if passTarget then
		local mode = detectedTeamSize()
		local profile = modeProfile(mode)
		local passMetric = profile.actions.pass
		local teamShotBias = mode == 3 and 0.18 or mode == 2 and 0.12 or 0
		local passThreshold = Options.PassShotThreshold.Value - profile.opponentCommitRate * 0.1 - teamShotBias
		if passMetric.samples >= 3 then passThreshold += passMetric.average * 0.04 end
		local ownPassOutcomes = profile.ownPassSamples + profile.ownPassMisses
		if ownPassOutcomes >= 3 then
			passThreshold += profile.ownPassQuality * 0.08
			passThreshold -= profile.ownPassMisses / ownPassOutcomes * 0.06
		end
		local peerPassOutcomes = profile.peerPassSamples + profile.peerPassMisses
		if peerPassOutcomes >= 3 then
			passThreshold += profile.peerPassQuality * 0.04
			passThreshold -= profile.peerPassMisses / peerPassOutcomes * 0.03
		end
		passThreshold = math.clamp(math.min(passThreshold, 0.68), 0.3, 0.68)
		if (blocked and not shotClear) or shotAlignment < passThreshold then
			return impact, nil, "pass", passTarget, passReceiverIndex
		end
	end
	local mode = detectedTeamSize()
	local teamShotBias = mode == 3 and 0.16 or mode == 2 and 0.12 or 0
	local shotThreshold = math.clamp(adaptiveShotAlignment() - teamShotBias, 0.46, 0.98)
	if Toggles.AutoStrike.Value and shotClear and shotAlignment >= shotThreshold then
		return impact, shotDirection, "shot"
	end
	return nil
end

local function applyGroundDribbleControls(c, st)
	if not Toggles.AutoGroundDribble or not Toggles.AutoGroundDribble.Value or aggressiveLeadMode
		or maneuver or not st.isOnGround or st.isFlipping or st.rot.up.z < 0.75 then return false end
	local ball = live and live.ball and live.ball.body
	local attack = attackDirection()
	if not ball or not attack or ball.pos.z > 150 then return false end
	local relative = flat(ball.pos - st.pos)
	local distance = vector.magnitude(relative)
	local lateral = vector.create(attack.y, -attack.x, 0)
	local forwardGap, sideGap = vector.dot(relative, attack), vector.dot(relative, lateral)
	local carHeading = flat(st.rot.forward)
	if distance < 70 or distance > 300 or forwardGap < 20 or forwardGap > 300
		or math.abs(sideGap) > 150 or vector.magnitude(carHeading) < 1
		or vector.dot(vector.normalize(carHeading), attack) < 0.25
		or vector.magnitude(flat(ball.vel - st.vel)) > 520 then return false end
	local passTarget = passOpportunity(ball.pos)
	if not shotLaneBlocked(ball.pos, attack) or passTarget then return false end
	local bestSide, bestScore = 1, -math.huge
	for _, side in { 1, -1 } do
		local candidate = ball.pos + attack * 220 + lateral * side * 170
		local nearestOpponent, nearestTeammate = math.huge, math.huge
		for _, entry in live.cars do
			if entry ~= live.me and entry.car and not entry.car.isDemoed then
				local other = entry.car.body
				local future = other.pos + other.vel * 0.25
				local separation = vector.magnitude(flat(candidate - future))
				if entry.team == live.me.team then
					nearestTeammate = math.min(nearestTeammate, separation)
				elseif entry.team ~= nil then
					nearestOpponent = math.min(nearestOpponent, separation)
				end
			end
		end
		local score = math.min(nearestOpponent, 700) - math.max(0, 220 - nearestTeammate) * 0.5
		if score > bestScore then bestSide, bestScore = side, score end
	end
	local target = ball.pos + attack * 220 + lateral * bestSide * 170
	local direction = flat(target - st.pos)
	if vector.magnitude(direction) < 1 then return false end
	local angle = angleTo(st.rot, direction)
	c.throttle = math.clamp(distance / 420, 0.35, 0.68)
	c.steer, c.jump, c.boost, c.handbrake = clamp1(angle / (math.pi / 2)), false, false, false
	return true
end

local function applyBounceShotControls(c, st)
	if not Toggles.AutoBounceShot or not Toggles.AutoBounceShot.Value or not st.isOnGround
		or maneuver or st.rot.up.z < 0.7 then return false end
	local attack = attackDirection()
	if not attack or #path < 3 then return false end
	local bounce, bounceTime
	for i = 2, #path - 1 do
		local previous, point, following = path[i - 1], path[i], path[i + 1]
		if point.t >= 0.08 and point.t <= Options.BounceShotWindow.Value and point.pos.z <= 125
			and previous.pos.z > point.pos.z and following.pos.z > point.pos.z + 4 then
			bounce, bounceTime = point.pos, point.t
			break
		end
	end
	if not bounce or vector.dot(flat(bounce), attack) < 0 then return false end
	if not aggressiveLeadMode and teammateCloser(st, bounce, bounceTime) then return false end
	if not aggressiveLeadMode and passOpportunity(bounce) then return false end
	local shotDirection = shotLaneBlocked(bounce, attack) and openShotDirection(bounce, attack) or attack
	if shotLaneBlocked(bounce, shotDirection) then return false end
	local setup = flat(bounce) - shotDirection * Options.ShotApproachOffset.Value
	local direction = flat(setup - st.pos)
	local distance = vector.magnitude(direction)
	if distance < 75 or distance > Options.BounceShotRange.Value then return false end
	local angle = angleTo(st.rot, direction)
	c.throttle = math.clamp(distance / 420, 0.25, 0.78)
	c.steer = clamp1(angle / (math.pi / 2))
	c.jump, c.handbrake = false, false
	c.boost = st.boost > 30 and distance > 350 and math.abs(angle) < 0.22
	return true
end

local function applyApproachBrake(c, st, target)
	if not Toggles.AutoApproachBrake or not Toggles.AutoApproachBrake.Value
		or not st.isOnGround or st.isFlipping or maneuver or not target then return false end
	local direction = flat(target - st.pos)
	local distance = vector.magnitude(direction)
	local speed = vector.magnitude(flat(st.vel))
	if distance > Options.ApproachBrakeDistance.Value or speed < Options.ApproachBrakeSpeed.Value or distance < 25 then return false end
	local closingSpeed = vector.dot(flat(st.vel), vector.normalize(direction))
	if closingSpeed < Options.ApproachBrakeSpeed.Value * 0.62 then return false end
	c.throttle = -math.clamp((closingSpeed - Options.ApproachBrakeSpeed.Value * 0.55)
		/ math.max(Options.ApproachBrakeSpeed.Value, 1) * 0.28, 0.08, 0.3)
	c.boost, c.handbrake = false, false
	return true
end

local function flickTarget(st, forceAttack)
	local goal = attackDirection()
	if forceAttack and goal then return st.pos + goal * 100, "flick" end
	local _, attack, kind, passTarget, passReceiverIndex = strikeOpportunity(st)
	if kind == "pass" and passTarget and not forceAttack then return passTarget, "pass", passReceiverIndex end
	if forceAttack and attack then return st.pos + attack * 100, "flick" end
	if (kind == "shot" or kind == "clear") and attack then return st.pos + attack * 100, "flick" end
	local forward = flat(st.rot.forward)
	local goal = attackDirection()
	if goal and vector.magnitude(forward) > 1 and vector.dot(vector.normalize(forward), goal) > 0.7 then
		return st.pos + goal * 100, "flick"
	end
	if vector.magnitude(forward) > 1 then return st.pos + forward * 100, "flick" end
	return nil
end

local function dribbleSetup(st)
	local ball = live and live.ball and live.ball.body
	if not ball or not st.isOnGround or st.rot.up.z < 0.7 then return false end
	local relative = ball.pos - st.pos
	local front = vector.dot(relative, st.rot.forward)
	local side = vector.dot(relative, st.rot.right)
	local height = vector.dot(relative, st.rot.up)
	local relativeSpeed = vector.magnitude(ball.vel - st.vel)
	return front >= 0 and front <= Options.FlickFrontMax.Value
		and math.abs(side) <= Options.FlickSideMax.Value
		and height >= Options.FlickHeightMin.Value and height <= Options.FlickHeightMax.Value
		and relativeSpeed <= Options.FlickRelativeSpeed.Value
end

local function timeToGround(st)
	local height = st.pos.z - Options.WaveDashGroundZ.Value
	if height <= 0 then return 0 end
	local gravity = Options.WaveDashGravity.Value
	local discriminant = st.vel.z * st.vel.z + 2 * gravity * height
	return (st.vel.z + math.sqrt(discriminant)) / gravity
end

local function wallShotOpportunity(st)
	if not st.isOnGround or st.rot.up.z <= -0.7 or st.rot.up.z >= 0.7 then return nil end
	local ball = live and live.ball and live.ball.body
	if not ball then return nil end
	local relative = ball.pos - (st.pos + st.vel * 0.1)
	local forward = vector.dot(relative, st.rot.forward)
	local side = vector.dot(relative, st.rot.right)
	if forward <= 0 or math.abs(side) > Options.WallShotSide.Value
		or vector.magnitude(relative) > Options.WallShotRange.Value then return nil end
	local target = st.pos + st.rot.forward * forward + st.rot.right * side
	return target
end

local function demoThreat(st)
	local airborne = not st.isOnGround
	local enabled = airborne and Toggles.AutoAirDemoEvade and Toggles.AutoAirDemoEvade.Value
		or not airborne and Toggles.AutoDemoEvade and Toggles.AutoDemoEvade.Value
	if not enabled or not Options.DemoEvadeRadius or (not airborne and st.rot.up.z < 0.7) or not live or not live.me then return nil end
	local me = live.me
	local best
	local radius = Options.DemoEvadeRadius.Value
	for _, entry in live.cars do
		if entry ~= me and entry.team ~= me.team and entry.car and not entry.car.isDemoed then
			local other = stateOf(entry.car)
			local relativePosition = other.pos - st.pos
			local relativeVelocity = other.vel - st.vel
			if not airborne then
				relativePosition, relativeVelocity = flat(relativePosition), flat(relativeVelocity)
			end
			local speedSquared = vector.dot(relativeVelocity, relativeVelocity)
			if speedSquared > 1 and vector.dot(relativePosition, relativeVelocity) < 0 then
				local impactTime = math.clamp(-vector.dot(relativePosition, relativeVelocity) / speedSquared, 0, airborne and 0.45 or 0.55)
				local missVector = relativePosition + relativeVelocity * impactTime
				local missDistance = vector.magnitude(missVector)
				if missDistance <= radius and (not best or impactTime < best.time) then
					best = {
						time = impactTime,
						side = vector.dot(relativePosition, st.rot.right),
						id = entry.index,
						away = st.pos - (other.pos + other.vel * impactTime),
					}
				end
			end
		end
	end
	return best
end

local boostRouteTarget
local function boostPadTarget(st)
	local threshold = Options.BoostRouteThreshold
	local ballBuffer = Options.BoostRouteBallBuffer
	local maxRange = Options.BoostRouteMaxRange
	if not Toggles.AutoBoostRoute or not Toggles.AutoBoostRoute.Value or not live
		or not threshold or not ballBuffer or not maxRange
		or not st.isOnGround or st.rot.up.z < 0.7 or st.boost >= threshold.Value then return nil end
	local ball = live.ball and live.ball.body
	if not ball or vector.magnitude(flat(ball.pos - st.pos)) < ballBuffer.Value then return nil end
	local best, bestScore
	for _, pad in live.pads do
		local pos = pad.pos
		if pad.isActive and pos then
			local direction = flat(pos - st.pos)
			local distance = vector.magnitude(direction)
			if distance >= 90 and distance <= maxRange.Value then
				local reserved = false
				if Toggles.AutoBoostPadReservation and Toggles.AutoBoostPadReservation.Value and live.me then
					for _, teammate in live.cars do
						if teammate ~= live.me and teammate.team == live.me.team and teammate.car and not teammate.car.isDemoed then
							local other = stateOf(teammate.car)
							local teammateDistance = vector.magnitude(flat(pos - (other.pos + other.vel * 0.2)))
							local toPad = flat(pos - other.pos)
							local toPadDistance = vector.magnitude(toPad)
							local alreadyApproaching = toPadDistance > 1
								and vector.dot(flat(other.vel), toPad) / toPadDistance > 100
							if teammateDistance + 100 < distance and (alreadyApproaching or teammateDistance < 300) then
								reserved = true
								break
							end
						end
					end
				end
				if not reserved then
					local turn = math.abs(angleTo(st.rot, direction))
					local largePad = pos.z > 72
					local score = distance + turn * 180 - (largePad and 250 or 0)
					if not bestScore or score < bestScore then best, bestScore = pos, score end
				end
			end
		end
	end
	return best
end

local function routeToBoostPad(c, st)
	boostRouteTarget = nil
	local target = boostPadTarget(st)
	if not target then return false end
	local direction = flat(target - st.pos)
	local distance = vector.magnitude(direction)
	if distance < 1 then return false end
	local angle = angleTo(st.rot, direction)
	boostRouteTarget = target
	c.throttle = 1
	c.steer = clamp1(angle / (math.pi / 2))
	c.boost = st.boost > 0 and distance > 250 and math.abs(angle) < 0.45
	c.jump = false
	c.handbrake = shouldPowerSlide(st, angle, distance)
	return true
end

local NX
local REPO = "https://gitlab.com/azulacs/catware-blox-league/-/raw/main/"
local NEXTO_VERSION = "2"

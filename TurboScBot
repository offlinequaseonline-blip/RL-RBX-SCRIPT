local function bestBallTarget(st)
	local best, bestDistance, bestTime, bestScore
	for _, pt in path do
		local carFuture = st.pos + st.vel * pt.t
		local delta = pt.pos - carFuture
		local distance = vector.magnitude(delta)
		local planar = flat(delta)
		local turn = vector.magnitude(planar) > 1 and math.abs(angleTo(st.rot, planar)) or 0
		local verticalPenalty = math.max(0, math.abs(delta.z) - 90) * (st.isOnGround and 0.35 or 0.18)
		local score = distance + turn * (st.isOnGround and 70 or 30) + verticalPenalty + pt.t * 35
		if not bestScore or score < bestScore then
			best, bestDistance, bestTime, bestScore = pt.pos, distance, pt.t, score
		end
	end
	return best, bestTime, bestDistance
end

local function maneuverPower(kind)
	local option = kind == "flick" and Options.FlickPower
		or (kind == "shot" or kind == "clear") and Options.ShotPower
		or kind == "pass" and Options.PassPower
	return option and math.clamp(option.Value, 0.1, 1) or 1
end

local function startDodge(st, target, kind, full3D, receiverIndexOverride)
	if maneuver or not st.isOnGround then return false end
	local dir = target - st.pos
	if not full3D then dir = flat(dir) end
	if vector.magnitude(dir) < 1 then dir = flat(st.rot.forward) end
	if vector.magnitude(dir) < 1 then return false end
	local a = angleTo(st.rot, dir)
	local p, y = -math.cos(a), math.sin(a)
	local m = math.max(math.abs(p), math.abs(y))
	if m < 1e-6 then return false end
	local heading = flat(st.rot.forward)
	if vector.magnitude(heading) < 1 then heading = vector.create(0, 1, 0) end
	local receiverIndex = receiverIndexOverride
	if kind == "pass" and live and live.me then
		if receiverIndex == nil then
			local lead = Options.PassLeadTime and Options.PassLeadTime.Value or 0.35
			local bestReceiverDistance
			for _, receiver in live.cars do
				if receiver ~= live.me and receiver.team == live.me.team and receiver.car and not receiver.car.isDemoed then
					local receiverState = stateOf(receiver.car)
					local future = receiverState.pos + receiverState.vel * lead
					local distance = vector.magnitude(flat(target - future))
					if not bestReceiverDistance or distance < bestReceiverDistance then
						receiverIndex, bestReceiverDistance = receiver.index, distance
					end
				end
			end
		end
	end
	kind = kind or "flip"
	maneuver = {
		kind = kind, power = maneuverPower(kind), t0 = now(), pitch = p / m, yaw = y / m,
		heading = vector.normalize(heading), targetDirection = vector.normalize(flat(dir)), targetPosition = target,
		receiverIndex = receiverIndex, sawFlip = false,
	}
	return true
end

local function startWaveDash(st, target)
	if maneuver or st.isOnGround or st.isFlipping or st.hasFlipped or st.hasDoubleJumped then return false end
	local dir = flat(target - st.pos)
	if vector.magnitude(dir) < 1 then return false end
	local a = angleTo(st.rot, dir)
	local p, y = -math.cos(a), math.sin(a)
	local m = math.max(math.abs(p), math.abs(y))
	if m < 1e-6 then return false end
	maneuver = { kind = "waveDash", t0 = now(), pitch = p / m, yaw = y / m, released = false }
	return true
end

local function startHalfFlip(st)
	if not startDodge(st, st.pos - st.rot.forward * 100, "halfFlip") then return false end
	maneuver.heading = -maneuver.heading
	return true
end

local function startFastAerial(st, target, minimumHeight)
	target = target or bestBallTarget(st)
	if not target or target.z - st.pos.z < (minimumHeight or Options.AerialHeight.Value) or st.boost <= 0 then return false end
	maneuver = { kind = "fastAerial", t0 = now(), target = target, wasAirborne = false }
	return true
end

local function startAerialDodge(st, target)
	if maneuver or st.isOnGround or st.isFlipping or st.hasFlipped or st.hasDoubleJumped then return false end
	local direction = flat(target - st.pos)
	if vector.magnitude(direction) < 1 then return false end
	local angle = angleTo(st.rot, direction)
	local pitch, yaw = -math.cos(angle), math.sin(angle)
	local magnitude = math.max(math.abs(pitch), math.abs(yaw))
	if magnitude < 1e-6 then return false end
	maneuver = { kind = "airDodge", t0 = now(), pitch = pitch / magnitude, yaw = yaw / magnitude, sawFlip = false }
	return true
end

local function runManeuver(c, st)
	local m = maneuver
	if not m then return false end
	local dt = now() - m.t0
	if dt < 0 then maneuver = nil return false end

	if m.kind == "waveDash" then
		if st.isOnGround or dt > Options.WaveDashDuration.Value then
			maneuver = nil
			c.jump = false
			return true
		end
		if not m.released then
			m.released = true
			c.jump = false
			return true
		end
		c.throttle, c.jump = 1, true
		c.pitch, c.yaw, c.roll = m.pitch, m.yaw, 0
		return true
	end

	if m.kind == "fastAerial" then
		if st.isOnGround and m.wasAirborne then maneuver = nil return false end
		if not st.isOnGround then m.wasAirborne = true end
		local target = bestBallTarget(st)
		if target then m.target = target end
		if dt > 2 or vector.magnitude(m.target - st.pos) < 120 then maneuver = nil return false end
		c.throttle, c.boost = 1, st.boost > 0
		recover(c, st, m.target - st.pos)
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		elseif dt < 0.2 and not st.hasDoubleJumped then
			c.jump = true
		else
			c.jump = false
		end
		return true
	end

	if m.kind == "airDodge" then
		if st.isOnGround or dt > 0.24 then
			maneuver = nil
			c.jump = false
			return false
		end
		if st.isFlipping then m.sawFlip = true end
		c.throttle, c.boost, c.handbrake = 1, false, false
		c.pitch, c.yaw, c.roll = m.pitch, m.yaw, 0
		c.jump = dt < 0.1
		if m.sawFlip and not st.isFlipping then
			maneuver = nil
			c.jump = false
		end
		return true
	end

	if m.kind == "halfFlip" then
		if dt > 0.9 then maneuver = nil return false end
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		elseif dt < 0.2 then
			c.jump, c.pitch, c.yaw, c.roll = true, m.pitch, m.yaw, 0
		else
			c.jump, c.throttle = false, 1
			recover(c, st, m.heading)
			if st.rot.up.z > 0.75 and vector.dot(flat(st.rot.forward), m.heading) > 0.7 then maneuver = nil end
		end
		return true
	end

	if m.kind == "speedFlip" then
		if dt > 0.9 then maneuver = nil return false end
		c.throttle, c.boost = 1, st.boost > 0
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		elseif dt < 0.2 then
			c.jump, c.pitch, c.yaw, c.roll = true, m.pitch, m.yaw, 0
		else
			c.jump, c.throttle, c.boost = false, 1, st.boost > 0
			c.pitch, c.yaw, c.roll = -m.pitch, m.yaw, 0
			if st.isFlipping then m.sawFlip = true elseif m.sawFlip then maneuver = nil end
		end
		return true
	end

	if m.kind == "flip" or m.kind == "shot" or m.kind == "pass" or m.kind == "clear" or m.kind == "flick" or m.kind == "wallShot" then
		if dt > 0.22 then maneuver = nil return false end
		c.throttle = m.power or 1
		c.boost = st.boost > 15 and (m.power or 1) >= 0.9
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		else
			c.jump, c.pitch, c.yaw, c.roll = true, m.pitch, m.yaw, 0
		end
		return true
	end

	maneuver = nil
	return false
end

local function nearBall(st, within)
	local b = path[math.max(1, math.floor(0.15 / (PATH_STRIDE * TICK)))]
	if not b or st.rot.up.z < 0.7 then return nil end
	local d = b.pos - (st.pos + st.vel * 0.15)
	if b.pos.z > 220 or math.abs(d.z) > 200 then return nil end
	local fwd, side = vector.dot(d, st.rot.forward), vector.dot(d, st.rot.right)
	if vector.magnitude(flat(d)) < within and fwd > -40 and math.abs(side) < 130 then return b.pos end
end

local function detectedTeamSize()
	if not live then return 1 end
	local teamCounts = {}
	for _, e in live.cars do
		if e.team ~= nil then teamCounts[e.team] = (teamCounts[e.team] or 0) + 1 end
	end
	local size = 1
	for _, count in teamCounts do size = math.max(size, count) end
	return math.clamp(size, 1, 3)
end

local learnedDoubleCommitRate = { [1] = 0, [2] = 0, [3] = 0 }

local function teamInterceptRank(st, target, interceptTime)
	local me = live and live.me
	if not me or me.team == nil or not Toggles.TeamCoordination or not Toggles.TeamCoordination.Value then return 1, nil end
	local t = interceptTime or 0
	local myFuture = st.pos + st.vel * t
	local myDistance = vector.magnitude(flat(target - myFuture))
	local mode = detectedTeamSize()
	local marginScale = mode == 3 and 1.1 or mode == 2 and 1 or 0
	local configuredMargin = Options.TeammateMargin.Value
	local minimumMargin = mode == 3 and 75 or mode == 2 and 60 or 0
	local margin = math.max(configuredMargin, minimumMargin) * marginScale
		+ math.clamp(learnedDoubleCommitRate[mode] * 15, 0, 15)
	local rank, leader, leaderDistance = 1, nil, math.huge
	for _, e in live.cars do
		if e ~= me and e.team == me.team and e.car and not e.car.isDemoed then
			local other = stateOf(e.car)
			local toTarget = flat(target - other.pos)
			local routeLength = vector.magnitude(toTarget)
			local direction = routeLength > 1 and vector.normalize(toTarget) or vector.create(0, 0, 0)
			local distance = vector.magnitude(flat(target - (other.pos + other.vel * t)))
			local approachSpeed = vector.dot(flat(other.vel), direction)
			local otherSpeed = vector.magnitude(flat(other.vel))
			local facing = vector.magnitude(flat(other.rot.forward)) > 0.01
				and vector.dot(vector.normalize(flat(other.rot.forward)), direction) or -1
			local committed = routeLength < 170
				or (approachSpeed > math.max(90, otherSpeed * 0.18) and facing > -0.15)
				or (otherSpeed < 90 and facing > 0.72 and routeLength < 420)
			if committed and distance + margin < myDistance then
				rank += 1
				if distance < leaderDistance then leader, leaderDistance = e, distance end
			end
		end
	end
	return rank, leader
end

local function teammateCloser(st, target, interceptTime)
	local rank, leader = teamInterceptRank(st, target, interceptTime)
	local wantsYield = rank > 1
	if wantsYield ~= teamRoleLock.yielding then
		if teamRoleLock.candidate ~= wantsYield then
			teamRoleLock.candidate, teamRoleLock.candidateSince = wantsYield, now()
		elseif now() - teamRoleLock.candidateSince >= 0.22 then
			teamRoleLock.yielding, teamRoleLock.candidate = wantsYield, nil
		end
	else
		teamRoleLock.candidate = nil
	end
	return teamRoleLock.yielding, teamRoleLock.yielding and rank or 1, teamRoleLock.yielding and leader or nil
end

local function attackDirection()
	local me = live and live.me
	if not me then return nil end
	local sign = me.team == 0 and 1 or me.team == 1 and -1 or nil
	if not sign then return nil end
	if Toggles.InvertAttackDirection.Value then sign = -sign end
	return vector.create(0, sign, 0)
end

local function applyTeamSupport(c, st, target, rank, leader)
	if not target or rank < 2 or not Toggles.TeamSupportRotation or not Toggles.TeamSupportRotation.Value then return false end
	local attack = attackDirection()
	if not attack then return false end
	local me = live and live.me
	local lateral = vector.create(attack.y, -attack.x, 0)
	local mode = detectedTeamSize()
	local baseDepth = Options.TeamSupportDepth.Value
	local depth = mode == 3 and rank >= 3 and baseDepth * 1.35 or baseDepth
	local lateralSpacing = Options.TeamSupportOffset.Value * (mode == 3 and 1.5 or 1)
	local function laneScore(side)
		local candidate = flat(target) - attack * depth + lateral * side * lateralSpacing
		local nearestTeammate, nearestOpponent = math.huge, math.huge
		for _, entry in live.cars do
			if entry ~= me and entry ~= leader and entry.car and not entry.car.isDemoed then
				local distance = vector.magnitude(flat(candidate - entry.car.body.pos))
				if entry.team == me.team then
					nearestTeammate = math.min(nearestTeammate, distance)
				elseif entry.team ~= nil then
					nearestOpponent = math.min(nearestOpponent, distance)
				end
			end
		end
		return math.min(nearestOpponent, 700) * 0.25 - math.max(0, 320 - nearestTeammate) * 0.8
	end
	local side = laneScore(1) >= laneScore(-1) and 1 or -1
	local support = flat(target) - attack * depth + lateral * side * lateralSpacing
	local direction = flat(support - st.pos)
	local distance = vector.magnitude(direction)
	c.jump, c.boost = false, false
	if not st.isOnGround then
		c.handbrake = false
		recover(c, st, direction)
		return true
	end
	if distance < 80 then
		c.throttle, c.steer, c.handbrake = 0, 0, false
		return true
	end
	local angle = angleTo(st.rot, direction)
	c.throttle = math.clamp(distance / 350, 0.25, 1)
	c.steer = clamp1(angle / (math.pi / 2))
	c.handbrake = shouldPowerSlide(st, angle, distance)
	c.boost = st.boost > 15 and distance > 500 and math.abs(angle) < 0.45
	return true
end

local function applyGoalSideShadow(c, st, rank)
	if not Toggles.AutoGoalShadow or not Toggles.AutoGoalShadow.Value or rank < 2 then return false end
	local ball = live and live.ball and live.ball.body
	local attack = attackDirection()
	if not ball or not attack then return false end
	local progress = vector.dot(flat(ball.pos), attack)
	local towardOwnGoal = -vector.dot(flat(ball.vel), attack)
	if progress > -Options.GoalShadowTrigger.Value or towardOwnGoal < 80 then return false end
	local depth = math.min(Options.GoalShadowDepth.Value, math.max(180, math.abs(progress) * 0.45))
	local target = flat(ball.pos) - attack * depth
	target += vector.create(-target.x * 0.25, 0, 0)
	local direction = flat(target - st.pos)
	local distance = vector.magnitude(direction)
	c.jump, c.boost = false, false
	if distance < 100 then
		c.throttle, c.steer, c.handbrake = 0, 0, false
		return true
	end
	local angle = angleTo(st.rot, direction)
	c.throttle = math.clamp(distance / 420, 0.25, 0.8)
	c.steer = clamp1(angle / (math.pi / 2))
	c.handbrake = shouldPowerSlide(st, angle, distance)
	if not st.isOnGround then recover(c, st, direction) end
	return true
end

local function incomingPassTarget(st)
	if not Toggles.AutoPassReceive or not Toggles.AutoPassReceive.Value or detectedTeamSize() < 2 then return nil end
	local ball = live and live.ball and live.ball.body
	if not ball or #path == 0 then return nil end
	local relative = flat(ball.pos - st.pos)
	local relativeVelocity = flat(ball.vel - st.vel)
	if vector.dot(relative, relativeVelocity) >= 0 then return nil end
	local best, bestTime, bestDistance, bestScore
	for _, point in path do
		local t = point.t
		if t >= 0.1 and t <= Options.PassReceiveHorizon.Value then
			local carFuture = st.pos + st.vel * t
			local delta = point.pos - carFuture
			local horizontal = vector.magnitude(flat(delta))
			local vertical = math.abs(delta.z)
			if horizontal <= Options.PassReceiveRange.Value and vertical <= Options.PassReceiveHeight.Value then
				local rank = teamInterceptRank(st, point.pos, t)
				local occupied = false
				local occupantRadius = math.clamp(Options.PassReceiveRange.Value * 0.35, 100, 250)
				for _, entry in live.cars do
					if entry ~= live.me and entry.car and not entry.car.isDemoed then
						local otherFuture = entry.car.body.pos + entry.car.body.vel * t
						if vector.magnitude(flat(point.pos - otherFuture)) <= occupantRadius then occupied = true break end
					end
				end
				if rank == 1 and not occupied then
					local score = horizontal + vertical * 0.6 + t * 75
					if not bestScore or score < bestScore then
						best, bestTime, bestDistance, bestScore = point.pos, t, vector.magnitude(delta), score
					end
				end
			end
		end
	end
	return best, bestTime, bestDistance
end

local function applyPassReceiveControls(c, st, target, interceptTime)
	if not target then return false end
	if st.isOnGround and Toggles.AutoFastAerial.Value and now() >= cooldown.aerial
		and target.z - st.pos.z >= Options.AerialHeight.Value
		and interceptTime <= Options.AerialMaxTime.Value and st.boost > 0 then
		if startFastAerial(st, target) then
			cooldown.aerial = now() + 2.5
			return runManeuver(c, st)
		end
	end
	if st.isOnGround and Toggles.AutoFlip.Value and now() >= cooldown.autoFlip then
		local impact = nearBall(st, Options.FlipRange.Value)
		if impact and startDodge(st, impact, "flip") then
			cooldown.autoFlip = now() + 0.9
			return runManeuver(c, st)
		end
	end
	local direction = flat(target - st.pos)
	local distance = vector.magnitude(direction)
	c.jump = false
	if not st.isOnGround then
		recover(c, st, direction)
		c.boost = st.boost > 0 and distance > 150
		c.handbrake = false
		return true
	end
	if distance < 80 then
		c.throttle, c.steer, c.boost, c.handbrake = 0.25, 0, false, false
		return true
	end
	local angle = angleTo(st.rot, direction)
	c.throttle = math.clamp(distance / 300, 0.3, 1)
	c.steer = clamp1(angle / (math.pi / 2))
	c.boost = st.boost > 15 and distance > 450 and math.abs(angle) < 0.45
	c.handbrake = shouldPowerSlide(st, angle, distance)
	return true
end

local function applyAirDribbleControls(c, st, force)
	if (not force and (not Toggles.AutoAirDribble or not Toggles.AutoAirDribble.Value))
		or st.isOnGround or st.isFlipping or maneuver then return false end
	local ball = live and live.ball and live.ball.body
	local attack = attackDirection()
	if not ball or not attack then return false end
	local intercept, interceptTime, interceptDistance = bestBallTarget(st)
	if intercept and interceptTime and interceptDistance
		and interceptTime <= Options.AirRedirectWindow.Value and interceptDistance <= Options.AirRedirectRange.Value then return false end
	local leadTime = math.clamp(vector.magnitude(flat(ball.pos - st.pos)) / math.max(vector.magnitude(flat(st.vel)), 300), 0.06, 0.18)
	local predictedBall = ball.pos + ball.vel * leadTime
	local predictionError = math.huge
	for _, point in path do
		local error = math.abs(point.t - leadTime)
		if error < predictionError then
			predictedBall, predictionError = point.pos, error
		end
	end
	local futureCar = st.pos + st.vel * leadTime
	local relative = predictedBall - futureCar
	local planarRelative = flat(relative)
	local distance = vector.magnitude(relative)
	local horizontalDistance = vector.magnitude(planarRelative)
	local lateralAxis = vector.create(attack.y, -attack.x, 0)
	local forwardGap = vector.dot(planarRelative, attack)
	local lateralGap = vector.dot(planarRelative, lateralAxis)
	local height = relative.z
	if distance > Options.AirDribbleRange.Value or horizontalDistance < 45 or forwardGap < 25
		or math.abs(lateralGap) > Options.AirDribbleRange.Value * 0.65
		or height < 15 or height > Options.AirDribbleVerticalRange.Value then return false end
	local behind = math.clamp(Options.AirDribbleBehind.Value + math.max(0, forwardGap - 120) * 0.12,
		Options.AirDribbleBehind.Value, Options.AirDribbleBehind.Value * 1.8)
	local target = predictedBall - attack * behind - UP * Options.AirDribbleBelow.Value
	local aim = target - st.pos
	local planarAim = flat(aim)
	local aimDistance = vector.magnitude(aim)
	if aimDistance < 1 then return false end
	local aimDirection = vector.normalize(aim)
	local closingSpeed = vector.dot(st.vel - ball.vel, aimDirection)
	local angle = angleTo(st.rot, planarAim)
	recover(c, st, aim)
	local maxClosing = Options.AirDribbleMaxClosing.Value
	local speedScale = closingSpeed > maxClosing and math.clamp(maxClosing / closingSpeed, 0.15, 1) or 1
	local turnScale = math.clamp(1 - math.max(0, math.abs(angle) - 0.45) * 0.7, 0.2, 1)
	local overspeed = closingSpeed > maxClosing * 1.15
	c.throttle = math.clamp(aimDistance / 360, 0.25, 0.85) * speedScale * turnScale
	c.jump, c.handbrake = false, false
	c.boost = st.boost > 0 and distance > 150 and not overspeed
		and closingSpeed < maxClosing * 0.9 and math.abs(angle) < 0.7
	airActions.dribbleActive = true
	return true
end


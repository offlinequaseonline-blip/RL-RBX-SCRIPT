local nx = { action = {0,0,0,0,0,0,0,0}, nextTick = 0, job = nil, kick = -1, lastGround = {}, spent = 0, deadline = 0 }

local function nxArena()
	local cars, me = {}, nil
	for _, e in live.cars do
		local w = { team = e.team, id = e.index, GetState = function() return stateOf(e.car) end }
		table.insert(cars, w)
		if e == live.me then me = w end
	end
	local ball = live.ball.body
	return {
		cars = cars, boostPads = live.pads,
		ball = { GetState = function() return { pos = ball.pos, vel = ball.vel, angVel = ball.angVel } end },
	}, me
end

local function kickoffTaker(arena, me)
	local ball = arena.ball:GetState().pos
	local function d(car) return vector.magnitude(flat(car:GetState().pos - ball)) end
	local mine, minD = d(me), math.huge
	for _, car in arena.cars do minD = math.min(minD, d(car)) end
	if math.abs(minD - mine) > 10 then return false end
	local mx = me:GetState().pos.x
	for _, car in arena.cars do
		if car ~= me and car.team == me.team and math.abs(d(car) - mine) <= 10 then
			local ox = car:GetState().pos.x
			local lateralTie = math.abs(ox - mx) <= 10
			local isLeft = me.team == 0 and ox < mx or me.team == 1 and ox > mx
			if lateralTie then
				if car.id == nil or me.id == nil or car.id < me.id then return false end
			elseif not isLeft then
				return false
			end
		end
	end
	return true
end

local NX_BUDGET = 0.004
if NX then
	NX.step = function()
		if os.clock() > nx.deadline then coroutine.yield() end
	end
end
local nextoWasEnabled = false
local function nextoControls(c, st)
	if not NX then error("Nexto isn't loaded (see the earlier warning)") end
	local tick = live.tick
	local arena, me
	if nx.pads ~= live.pads then nx.pads, nx.padMap = live.pads, nil end
	if not nx.job and tick >= nx.nextTick then
		nx.nextTick = tick + 8
		arena, me = nxArena()
		local q, kv = NX.buildObs(arena, me, tick, nx)
		nx.job = coroutine.create(function() return NX:forward(q, kv) end)
	end
	if nx.job and nx.spent < NX_BUDGET then
		local t0 = os.clock()
		nx.deadline = t0 + NX_BUDGET - nx.spent
		local ok, best = coroutine.resume(nx.job)
		nx.spent += os.clock() - t0
		if not ok then nx.job = nil error(best) end
		if coroutine.status(nx.job) == "dead" then
			nx.job = nil
			nx.action = NX.ACTIONS[best]
			nx.lastBest = best
		end
	end
	local a = nx.action
	local ball = live.ball.body
	local kickoffPause = kickoffPaused(ball)
	if kickoffPause then
		local speed = vector.magnitude(st.vel)
		if speed < 5 then nx.kickArmed = true end
		if nx.kickTick == nil then
			if not arena then arena, me = nxArena() end
			nx.kick = kickoffTaker(arena, me) and 0 or -2
			if nx.kickArmed and speed > 5 then nx.kickTick = nx.kick == 0 and tick or false end
		end
		if nx.kick >= 0 then
			if nx.kickTick then nx.kick = tick - nx.kickTick end
			if NX.KICKOFF[nx.kick + 1] then a = NX.KICKOFF[nx.kick + 1] nx.action = a end
		end
	else
		nx.kick, nx.kickTick, nx.kickArmed = -1, nil, false
	end
	c.throttle, c.steer, c.pitch, c.yaw, c.roll = a[1], a[2], a[3], a[4], a[5]
	c.jump, c.boost, c.handbrake = a[6] > 0, a[7] > 0, a[8] > 0
end

local function drive(c)
	boostRouteTarget = nil
	airActions.dribbleActive = false
	airActions.passActive = false
	local me = live.me
	if not me then resetControlState() return end
	if not Toggles.NextoBot or not Toggles.AutoSpeedFlip or not Toggles.AutoPass then return end
	if Library.Unloaded then return end
	if controlSource ~= live.source or (controlTick and live.tick < controlTick) then
		resetControlState()
		nx.job, nx.action, nx.nextTick = nil, {0,0,0,0,0,0,0,0}, live.tick
		nx.kick, nx.kickTick, nx.kickArmed = -1, nil, false
	end
	controlSource, controlTick = live.source, live.tick
	local st = stateOf(me.car)
	if nextoWasEnabled ~= Toggles.NextoBot.Value then
		nextoWasEnabled = Toggles.NextoBot.Value
		nx.job, nx.action, nx.nextTick = nil, {0,0,0,0,0,0,0,0}, live.tick
		nx.kick, nx.kickTick, nx.kickArmed = -1, nil, false
		resetControlState()
	end
	if Toggles.NextoBot.Value then
		if maneuver then
			if maneuver.kind == "airDodge" and Toggles.AutoAerialDodge.Value and runManeuver(c, st) then return end
			if Toggles.NextoTacticalAssists and Toggles.NextoTacticalAssists.Value then
				if maneuver.kind == "pass" and Toggles.AutoPass.Value and runManeuver(c, st) then return end
				if (maneuver.kind == "shot" or maneuver.kind == "clear") and Toggles.AutoStrike.Value and runManeuver(c, st) then return end
			if maneuver.kind == "flick" and Toggles.AutoFlick.Value and (Toggles.AutoFlickPossession.Value or aggressiveLeadMode) and runManeuver(c, st) then return end
			end
			maneuver = nil
		end
		local ok, nextoError = pcall(nextoControls, c, st)
		if not ok then
			nx.job = nil
			recordRuntimeError("Nexto", nextoError)
		else
			local threat = demoThreat(st)
			if threat then
				if not st.isOnGround then
					recover(c, st, threat.away)
					c.throttle, c.jump, c.boost, c.handbrake = 0.25, false, false, false
					return
				end
				local side = threat.side
				if math.abs(side) < 1 then side = (threat.id or 0) % 2 == 0 and 1 or -1 end
				c.steer, c.handbrake = side > 0 and -1 or 1, true
				c.jump, c.boost = false, false
				return
			end
			if not Toggles.NextoTacticalAssists or not Toggles.NextoTacticalAssists.Value then
				if applyAirDribbleControls(c, st, false) then return end
				local airTarget, airTime, airDistance = bestBallTarget(st)
				if applyAerialDodge(c, st, airTarget, airTime, airDistance, aggressiveLeadMode) then return end
				if applyAirRedirectControls(c, st, airTarget, airTime, airDistance, aggressiveLeadMode) then return end
				if applyAirInterceptControls(c, st, airTarget, airTime, airDistance, aggressiveLeadMode) then return end
				if applyBounceShotControls(c, st) then return end
				if applyGroundDribbleControls(c, st) then return end
				if aggressiveLeadMode then
					local target, interceptTime, interceptDistance = bestBallTarget(st)
					local yielding = not aggressiveLeadMode and target and teammateCloser(st, target, interceptTime) or false
					if not yielding and not st.isOnGround and applyAirDribbleControls(c, st, true) then return end
					local aerialRange = adaptiveAerialRange() + 250
					if not yielding and Toggles.AutoFastAerial.Value and st.isOnGround and now() >= cooldown.aerial
						and target and interceptTime <= Options.AerialMaxTime.Value and interceptDistance <= aerialRange
						and target.z - st.pos.z >= Options.AerialHeight.Value * 0.7 and st.boost > 0 then
						if startFastAerial(st, target, Options.AerialHeight.Value * 0.7) then
							cooldown.aerial = now() + 2.5
							if runManeuver(c, st) then return end
						end
					end
					if not yielding and (Toggles.AutoStrike.Value or Toggles.AutoPass.Value)
						and st.isOnGround and c.throttle > 0.4 and now() >= cooldown.strike then
						local impact, attack, kind, passTarget, passReceiverIndex = strikeOpportunity(st, true)
						local strikeTarget = kind == "pass" and passTarget or attack and (st.pos + attack * 100)
						if impact and strikeTarget and kind and startDodge(st, strikeTarget, kind, false, passReceiverIndex)
							and runManeuver(c, st) then
							cooldown.strike = now() + 1.0
							return
						end
					end
				end
				if applyApproachBrake(c, st, airTarget) then return end
				if applyDriftCorrection(c, st) then return end
				return
			end
			if c.handbrake and not shouldPowerSlide(st, c.steer) then c.handbrake = false end
			local receiveTarget, receiveTime = incomingPassTarget(st)
			if receiveTarget and applyPassReceiveControls(c, st, receiveTarget, receiveTime) then return end
			local target, interceptTime = bestBallTarget(st)
			local yielding, teamRank, teamLeader = false, 1, nil
			if target and not aggressiveLeadMode then yielding, teamRank, teamLeader = teammateCloser(st, target, interceptTime) end
			if yielding then
				if applyGoalSideShadow(c, st, teamRank) then return end
				if not applyTeamSupport(c, st, target, teamRank, teamLeader) then
					c.throttle = math.clamp(c.throttle, -0.2, 0.25)
					c.jump, c.boost, c.handbrake = false, false, false
				end
			else
				if (Toggles.AutoStrike.Value or Toggles.AutoPass.Value) and st.isOnGround and c.throttle > 0.4 and now() >= cooldown.strike then
					local impact, attack, kind, passTarget, passReceiverIndex = strikeOpportunity(st, aggressiveLeadMode)
					local target = kind == "pass" and passTarget or attack and (st.pos + attack * 100)
					if impact and target and kind and (aggressiveLeadMode or not teammateCloser(st, impact, 0.15))
						and startDodge(st, target, kind, false, passReceiverIndex) then
						cooldown.strike = now() + 1.0
						if runManeuver(c, st) then return end
					end
				end
				if not maneuver and Toggles.AutoFlick.Value and (Toggles.AutoFlickPossession.Value or aggressiveLeadMode)
					and st.isOnGround and now() >= cooldown.flick and dribbleSetup(st) then
					local flick, kind, receiverIndex = flickTarget(st, aggressiveLeadMode)
					if flick and startDodge(st, flick, kind or "flick", false, receiverIndex) then
						cooldown.flick = now() + 0.8
						if kind == "pass" then cooldown.strike = now() + 1.0 end
						runManeuver(c, st)
					end
				end
				if not maneuver and applyShotApproachControls(c, st, target, target and vector.magnitude(flat(target - st.pos)) or nil) then return end
				if not yielding and applyAirDribbleControls(c, st, aggressiveLeadMode) then return end
				if not yielding and applyAerialDodge(c, st, target, interceptTime,
					target and vector.magnitude(target - st.pos) or nil, aggressiveLeadMode) then return end
				if not yielding and applyAirRedirectControls(c, st, target, interceptTime,
					target and vector.magnitude(target - st.pos) or nil, aggressiveLeadMode) then return end
				if not yielding and applyAirInterceptControls(c, st, target, interceptTime,
					target and vector.magnitude(target - st.pos) or nil, aggressiveLeadMode) then return end
				if not yielding and applyBounceShotControls(c, st) then return end
				if not yielding and applyGroundDribbleControls(c, st) then return end
				if not yielding and applyApproachBrake(c, st, target) then return end
				if not yielding and applyDriftCorrection(c, st) then return end
			end
		end
		return
	end
	if not maneuver then
		local threat = demoThreat(st)
		if threat then
			if not st.isOnGround then
				recover(c, st, threat.away)
				c.throttle, c.jump, c.boost, c.handbrake = 0.25, false, false, false
				lastJumpInput = false
				return
			end
			local side = threat.side
			if math.abs(side) < 1 then side = (threat.id or 0) % 2 == 0 and 1 or -1 end
			c.steer = side > 0 and -1 or 1
			c.handbrake = true
			lastJumpInput = c.jump == true
			return
		end
	end

	local userJump = c.jump == true
	local jumpPressed = userJump and not lastJumpInput
	lastJumpInput = userJump
	if st.isOnGround and jumpPressed then lastGroundJumpAt = now() end
	local ball = live.ball and live.ball.body
	local kickoffPause = kickoffPaused(ball)
	local speed = vector.magnitude(st.vel)
	if kickoffPause and speed < 5 then
		kickoffAssist.armed = true
		local arena, kickoffMe = nxArena()
		kickoffAssist.isTaker = kickoffMe ~= nil and kickoffTaker(arena, kickoffMe)
	end
	if not kickoffPause and kickoffAssist.armed then
		if Toggles.AutoKickoffSupport.Value and not kickoffAssist.isTaker and detectedTeamSize() > 1 then
			kickoffAssist.supportUntil = now() + 1.1
		end
	end
	if Toggles.AutoSpeedFlip.Value and kickoffAssist.armed and not kickoffAssist.locked and speed > adaptiveKickoffStartSpeed() then
		if st.isOnGround then
			local arena, kickoffMe = nxArena()
			if kickoffMe and kickoffTaker(arena, kickoffMe) then
				local side = st.pos.x >= ball.pos.x and 1 or -1
				local target = st.pos + flat(st.rot.forward) * 100 + flat(st.rot.right) * (100 * side)
				kickoffAssist.locked = startDodge(st, target, "speedFlip")
			end
		end
	end
	if not kickoffPause then
		kickoffAssist.armed, kickoffAssist.locked = false, false
	end
	if not kickoffPause and Toggles.AutoKickoffSupport.Value and now() < kickoffAssist.supportUntil then
		local attack = attackDirection()
		local target = bestBallTarget(st)
		target = target or ball.pos
		if attack then
			local lateral = vector.create(attack.y, -attack.x, 0)
			local side = (math.floor(tonumber(me.index) or 1) % 2 == 0) and 1 or -1
			local support = flat(target) - attack * Options.KickoffSupportDepth.Value
				+ lateral * side * Options.KickoffSupportOffset.Value
			local direction = flat(support - st.pos)
			local distance = vector.magnitude(direction)
			c.jump, c.boost, c.handbrake = false, false, false
			if distance < 80 then
				c.throttle, c.steer = 0, 0
			else
				local angle = angleTo(st.rot, direction)
				c.throttle = math.clamp(distance / 420, 0.3, 0.75)
				c.steer = clamp1(angle / (math.pi / 2))
			end
			lastJumpInput = c.jump == true
			return
		end
	end

	local incomingTarget, incomingTime = incomingPassTarget(st)
	if incomingTarget and applyPassReceiveControls(c, st, incomingTarget, incomingTime) then
		lastJumpInput = c.jump == true
		return
	end
	local intercept, interceptTime, interceptDistance = bestBallTarget(st)
	local yielding, teamRank, teamLeader = false, 1, nil
	if intercept and not aggressiveLeadMode then yielding, teamRank, teamLeader = teammateCloser(st, intercept, interceptTime) end
	if yielding then
		if applyGoalSideShadow(c, st, teamRank) or applyTeamSupport(c, st, intercept, teamRank, teamLeader) then
			lastJumpInput = c.jump == true
			return
		end
	end
	if not yielding and applyAirDribbleControls(c, st, aggressiveLeadMode) then
		lastJumpInput = c.jump == true
		return
	end
	if not yielding and applyAerialDodge(c, st, intercept, interceptTime, interceptDistance, aggressiveLeadMode) then
		lastJumpInput = c.jump == true
		return
	end
	if not yielding and applyAirRedirectControls(c, st, intercept, interceptTime, interceptDistance, aggressiveLeadMode) then
		lastJumpInput = c.jump == true
		return
	end
	if not yielding and applyAirInterceptControls(c, st, intercept, interceptTime, interceptDistance, aggressiveLeadMode) then
		lastJumpInput = c.jump == true
		return
	end
	if not yielding and applyBounceShotControls(c, st) then
		lastJumpInput = c.jump == true
		return
	end
	local aerialRange = adaptiveAerialRange() + (aggressiveLeadMode and 250 or 0)
	local forward, toIntercept = flat(st.rot.forward), intercept and flat(intercept - st.pos)
	local behindBall = false
	if intercept and toIntercept and vector.magnitude(toIntercept) > Options.FlipRange.Value
		and vector.magnitude(toIntercept) < Options.HalfFlipRange.Value
		and vector.magnitude(forward) > 1 and vector.magnitude(toIntercept) > 1 then
		behindBall = vector.dot(vector.normalize(forward), vector.normalize(toIntercept)) < -0.55
	end
	local manualHalfFlip = jumpPressed and c.throttle < -0.5
	if not maneuver and Toggles.AutoHalfFlip.Value and st.isOnGround and st.rot.up.z > 0.7 and now() >= cooldown.halfFlip
		and manualHalfFlip and startHalfFlip(st) then
		cooldown.halfFlip = now() + 1.2
	end
	if not maneuver and Toggles.AutoFlick.Value and (jumpPressed or Toggles.AutoFlickPossession.Value or aggressiveLeadMode)
		and st.isOnGround and now() >= cooldown.flick
		and dribbleSetup(st) then
		local target, kind, receiverIndex = flickTarget(st, aggressiveLeadMode)
		if target and startDodge(st, target, kind or "flick", false, receiverIndex) then
			cooldown.flick = now() + 0.8
			if kind == "pass" then cooldown.strike = now() + 1.0 end
		end
	end
	if not maneuver and (Toggles.AutoStrike.Value or Toggles.AutoPass.Value) and st.isOnGround
		and now() >= cooldown.strike and c.throttle > 0.4 then
		local impact, attack, kind, passTarget, passReceiverIndex = strikeOpportunity(st, aggressiveLeadMode)
		if impact and (aggressiveLeadMode or not teammateCloser(st, impact, 0.15)) then
			local target = kind == "pass" and passTarget or attack and (st.pos + attack * 100)
			if target and startDodge(st, target, kind, false, passReceiverIndex) then cooldown.strike = now() + 1.0 end
		end
	end
	if not yielding and applyShotApproachControls(c, st, intercept, interceptDistance) then
		lastJumpInput = c.jump == true
		return
	end
	if not yielding and applyGroundDribbleControls(c, st) then
		lastJumpInput = c.jump == true
		return
	end
	local contextualHalfFlip = c.throttle > 0.4 and behindBall and intercept
		and not teammateCloser(st, intercept, interceptTime)
	if not maneuver and Toggles.AutoHalfFlip.Value and st.isOnGround and st.rot.up.z > 0.7 and now() >= cooldown.halfFlip
		and contextualHalfFlip and startHalfFlip(st) then
		cooldown.halfFlip = now() + 1.2
	end
	if not maneuver and Toggles.AutoFastAerial.Value and st.isOnGround and st.rot.up.z > 0.7 and now() >= cooldown.aerial
		and intercept and interceptTime <= Options.AerialMaxTime.Value
		and interceptDistance <= aerialRange
		and intercept.z - st.pos.z >= Options.AerialHeight.Value * (aggressiveLeadMode and 0.7 or 1)
		and st.boost > 0 and c.throttle > -0.3
		and not teammateCloser(st, intercept, interceptTime) then
		if startFastAerial(st, intercept) then cooldown.aerial = now() + 2.5 end
	end
	if not maneuver and Toggles.AutoFlip.Value and st.isOnGround and now() >= cooldown.autoFlip then
		local b = nearBall(st, Options.FlipRange.Value)
		if b and c.throttle > -0.3 and not teammateCloser(st, b, 0.15) and startDodge(st, b, "flip") then
			cooldown.autoFlip = now() + 0.9
		end
	end
	if not maneuver and Toggles.AutoWaveDash.Value and not st.isOnGround and not st.isFlipping
		and not st.hasFlipped and not st.hasDoubleJumped and not c.boost and st.rot.up.z > 0.85
		and st.vel.z < -80 and vector.magnitude(flat(st.vel)) >= Options.WaveDashMinSpeed.Value
		and lastGroundJumpAt and now() - lastGroundJumpAt <= Options.WaveDashJumpWindow.Value
		and now() >= cooldown.waveDash then
		local landingTime = timeToGround(st)
		if landingTime >= 0 and landingTime <= adaptiveWaveDashLead() then
			local direction = flat(st.vel)
			if vector.magnitude(direction) < 1 then direction = flat(st.rot.forward) end
			if startWaveDash(st, st.pos + direction * 100) then cooldown.waveDash = now() + 0.4 end
		end
	end
	if not maneuver and Toggles.AutoWallShot.Value and st.isOnGround and now() >= cooldown.wallShot and c.throttle > 0.2 then
		local target = wallShotOpportunity(st)
		if target and not teammateCloser(st, target, 0.1) and startDodge(st, target, "wallShot", true) then
			cooldown.wallShot = now() + 0.9
		end
	end

	if maneuver then
		local enabled = (maneuver.kind == "flip" and Toggles.AutoFlip.Value)
			or ((maneuver.kind == "shot" or maneuver.kind == "clear") and Toggles.AutoStrike.Value)
			or (maneuver.kind == "pass" and Toggles.AutoPass.Value)
			or (maneuver.kind == "flick" and Toggles.AutoFlick.Value)
			or (maneuver.kind == "wallShot" and Toggles.AutoWallShot.Value)
			or (maneuver.kind == "halfFlip" and Toggles.AutoHalfFlip.Value)
			or (maneuver.kind == "speedFlip" and Toggles.AutoSpeedFlip.Value)
			or (maneuver.kind == "fastAerial" and Toggles.AutoFastAerial.Value)
			or (maneuver.kind == "waveDash" and Toggles.AutoWaveDash.Value)
		if not enabled then maneuver = nil end
	end
	if runManeuver(c, st) then return end
	if routeToBoostPad(c, st) then return end
	if applyApproachBrake(c, st, intercept) then return end
	if applyDriftCorrection(c, st) then return end
	if Toggles.AutoAirFollow.Value and not st.isOnGround and not st.isFlipping and c.boost
		and math.abs(c.pitch) + math.abs(c.yaw) + math.abs(c.roll) < 0.1
		and intercept and interceptTime <= Options.AerialMaxTime.Value
		and interceptDistance <= aerialRange and st.boost > 0
		and not teammateCloser(st, intercept, interceptTime) then
		recover(c, st, intercept - st.pos)
		c.boost = true
		return
	end

	if st.rot.up.z > 0.7 and c.throttle > 0.2 and shouldPowerSlide(st, c.steer) then
		c.handbrake = true
	end
	local idleAir = math.abs(c.pitch) + math.abs(c.yaw) + math.abs(c.roll) < 0.1
	if Toggles.AutoRecover.Value and idleAir and not st.isOnGround and not st.isFlipping then
		local v = flat(st.vel)
		recover(c, st, vector.magnitude(v) > 300 and v or nil)
	end
end

local function applyBoostReserve(c)
	if not uiReady or not Toggles.AutoBoostReserve or not Toggles.AutoBoostReserve.Value
		or not c.boost or boostRouteTarget then return end
	local me = live and live.me
	if not me or not me.car then return end
	local st = stateOf(me.car)
	if st.boost > Options.BoostReserve.Value then return end
	local target, interceptTime, interceptDistance = bestBallTarget(st)
	local urgent = target and interceptTime and interceptDistance
		and interceptTime <= 0.35 and interceptDistance <= 360
	if maneuver and maneuver.kind == "fastAerial" and interceptTime and interceptTime <= Options.AerialMaxTime.Value then
		urgent = true
	end
	if not urgent then c.boost = false end
end

local actionCategory = {
	shot = "shot", clear = "shot", pass = "pass",
	flip = "challenge", fastAerial = "challenge", halfFlip = "challenge",
	flick = "challenge", wallShot = "challenge", airDribble = "airDribble",
	speedFlip = "speedFlip", waveDash = "waveDash",
}

local function beginLearningTrial(activeManeuver)
	local category = actionCategory[activeManeuver.kind]
	local me = live and live.me
	local ball = live and live.ball and live.ball.body
	if not category or not me or not ball then return nil end
	local state = stateOf(me.car)
	return {
		maneuver = activeManeuver,
		category = category,
		mode = detectedTeamSize(),
		tick = live.tick,
		ballPosition = ball.pos,
		ballVelocity = ball.vel,
		attack = attackDirection(),
		targetDirection = activeManeuver.targetDirection,
		targetPosition = activeManeuver.targetPosition,
		receiverIndex = activeManeuver.receiverIndex,
		passLead = Options.PassLeadTime and Options.PassLeadTime.Value or 0.35,
		distance = vector.magnitude(flat(ball.pos - state.pos)),
		speed = vector.magnitude(flat(state.vel)),
	}
end

local function finishLearningTrial(trial)
	if not live or live.source ~= "match" or live.tick < trial.tick then return end
	local me = live.me
	local ball = live.ball and live.ball.body
	if not me or not ball then return end
	local state = stateOf(me.car)
	local reward
	if (trial.category == "shot" and (trial.targetDirection or trial.attack))
		or (trial.category == "pass" and trial.targetDirection) then
		local direction = trial.category == "shot" and (trial.targetDirection or trial.attack) or trial.targetDirection
		local before = vector.dot(trial.ballVelocity, direction)
		local after = vector.dot(ball.vel, direction)
		reward = (after - before) / math.max(math.abs(before), math.abs(after), 1)
	elseif trial.category == "waveDash" or trial.category == "speedFlip" then
		local speed = vector.magnitude(flat(state.vel))
		reward = (speed - trial.speed) / math.max(trial.speed, 1)
	elseif trial.category == "challenge" or trial.category == "airDribble" then
		local distance = vector.magnitude(flat(ball.pos - state.pos))
		local closeness = unitValue((trial.distance - distance) / math.max(trial.distance, 1))
		local progress = trial.attack and vector.dot(flat(ball.pos - trial.ballPosition), trial.attack) or 0
		local velocityProgress = trial.attack and vector.dot(flat(ball.vel - trial.ballVelocity), trial.attack) or 0
		reward = closeness * 0.35 + progress / 450 * 0.3 + velocityProgress / 900 * 0.35
	else
		local distance = vector.magnitude(flat(ball.pos - state.pos))
		reward = (trial.distance - distance) / math.max(trial.distance, 1)
	end
	reward = unitValue(reward or 0)
	local metric = modeProfile(trial.mode).actions[trial.category]
	metric.samples += 1
	local rate = 1 / math.min(metric.samples, 8)
	metric.average = unitValue(metric.average + (reward - metric.average) * rate)
	learningDirty = true
	if trial.category == "pass" and trial.receiverIndex ~= nil and not pendingOwnPass then
		local passDistance = trial.targetPosition and vector.magnitude(flat(trial.targetPosition - ball.pos)) or 0
		local passSpeed = math.max(vector.magnitude(flat(ball.vel)), Options.ClearIncomingSpeed.Value)
		pendingOwnPass = {
			receiverIndex = trial.receiverIndex,
			expectedTime = math.clamp(math.max(trial.passLead or 0.35, passDistance / passSpeed), 0.1, 3),
			startedAt = os.clock(),
			mode = trial.mode,
			quality = reward,
		}
	end
end

local function observeOpponentPressure()
	if os.clock() - lastOpponentSampleAt < 0.5 then return end
	lastOpponentSampleAt = os.clock()
	local me = live and live.me
	local ball = live and live.ball and live.ball.body
	if not me or not ball or me.team == nil then return end
	local ownDistance, opponentDistance = math.huge, math.huge
	local ownNear, opponentNear = 0, 0
	local futureBall = ball.pos + ball.vel * 0.35
	for _, entry in live.cars do
		if entry.car and not entry.car.isDemoed then
			local distance = vector.magnitude(flat(ball.pos - entry.car.body.pos))
			local futureDistance = vector.magnitude(flat(futureBall - (entry.car.body.pos + entry.car.body.vel * 0.35)))
			if entry.team == me.team then
				ownDistance = math.min(ownDistance, distance)
				if futureDistance < 650 then ownNear += 1 end
			elseif entry.team ~= nil then
				opponentDistance = math.min(opponentDistance, distance)
				if futureDistance < 650 then opponentNear += 1 end
			end
		end
	end
	if ownDistance == math.huge or opponentDistance == math.huge then return end
	local profile = modeProfile(detectedTeamSize())
	profile.pressureSamples += 1
	local rate = 1 / math.min(profile.pressureSamples, 8)
	local observedPressure = opponentDistance < ownDistance and 1 or 0
	profile.opponentPressure += (observedPressure - profile.opponentPressure) * rate
	if detectedTeamSize() > 1 then
		profile.coordinationSamples += 1
		local coordinationRate = 1 / math.min(profile.coordinationSamples, 12)
		local teamDoubleCommit = ownNear > 1 and 1 or 0
		local opponentDoubleCommit = opponentNear > 1 and 1 or 0
		profile.teamCommitRate = math.clamp(profile.teamCommitRate + (teamDoubleCommit - profile.teamCommitRate) * coordinationRate, 0, 1)
		profile.opponentCommitRate = math.clamp(profile.opponentCommitRate + (opponentDoubleCommit - profile.opponentCommitRate) * coordinationRate, 0, 1)
		learnedDoubleCommitRate[detectedTeamSize()] = profile.teamCommitRate
	end
	learningDirty = true
end

local function observePlayerPatterns()
	local stamp = os.clock()
	if stamp - lastPeerPatternAt < 0.18 then return end
	lastPeerPatternAt = stamp
	local me = live and live.me
	local ball = live and live.ball and live.ball.body
	if not me or not ball or me.team == nil then return end
	local mode = detectedTeamSize()
	local receiveRange = Options.PassReceiveRange and Options.PassReceiveRange.Value or 450
	if pendingPeerPass then
		local pending = pendingPeerPass
		local receiver
		for _, entry in live.cars do
			if entry.index == pending.receiverIndex and entry.car and not entry.car.isDemoed then receiver = entry break end
		end
		local elapsed = stamp - pending.startedAt
		if receiver then
			local separation = vector.magnitude(flat(ball.pos - receiver.car.body.pos))
			if elapsed >= math.max(0.1, pending.expectedTime * 0.65) and separation <= math.clamp(receiveRange * 0.5, 150, 350) then
				local profile = modeProfile(pending.mode)
				profile.peerPassSamples += 1
				local rate = 1 / math.min(profile.peerPassSamples, 8)
				profile.peerPassLead = math.clamp(profile.peerPassLead + (elapsed - profile.peerPassLead) * rate, 0.1, 3)
				profile.peerPassQuality = unitValue(profile.peerPassQuality + (pending.quality - profile.peerPassQuality) * rate)
				learningDirty = true
				pendingPeerPass = nil
			elseif elapsed > pending.expectedTime + 0.75 then
				local profile = modeProfile(pending.mode)
				profile.peerPassMisses += 1
				learningDirty = true
				pendingPeerPass = nil
			end
		else
			pendingPeerPass = nil
		end
	end
	if pendingOwnPass then
		local pending = pendingOwnPass
		local receiver
		for _, entry in live.cars do
			if entry.index == pending.receiverIndex and entry.team == me.team and entry.car and not entry.car.isDemoed then
				receiver = entry
				break
			end
		end
		local elapsed = stamp - pending.startedAt
		if receiver then
			local separation = vector.magnitude(flat(ball.pos - receiver.car.body.pos))
			if elapsed >= math.max(0.1, pending.expectedTime * 0.65) and separation <= math.clamp(receiveRange * 0.5, 150, 350) then
				local profile = modeProfile(pending.mode)
				profile.ownPassSamples += 1
				local rate = 1 / math.min(profile.ownPassSamples, 8)
				profile.ownPassLead = math.clamp(profile.ownPassLead + (elapsed - profile.ownPassLead) * rate, 0.1, 3)
				profile.ownPassQuality = unitValue(profile.ownPassQuality + (pending.quality - profile.ownPassQuality) * rate)
				learningDirty = true
				pendingOwnPass = nil
			elseif elapsed > pending.expectedTime + 0.75 then
				local profile = modeProfile(pending.mode)
				profile.ownPassMisses += 1
				learningDirty = true
				pendingOwnPass = nil
			end
		else
			local profile = modeProfile(pending.mode)
			profile.ownPassMisses += 1
			learningDirty = true
			pendingOwnPass = nil
		end
	end
	local currentVelocity = flat(ball.vel)
	local previousVelocity = previousPeerBallVelocity
	previousPeerBallVelocity = currentVelocity
	if not previousVelocity or stamp - lastPeerTouchAt < 0.45 then return end
	local impulse = currentVelocity - previousVelocity
	local impulseMagnitude = vector.magnitude(impulse)
	if impulseMagnitude < 150 then return end
	local hitter, hitterDistance
	for _, entry in live.cars do
		if entry ~= me and entry.team ~= nil and entry.car and not entry.car.isDemoed then
			local distance = vector.magnitude(flat(ball.pos - entry.car.body.pos))
			if distance <= 240 and (not hitterDistance or distance < hitterDistance) then
				hitter, hitterDistance = entry, distance
			end
		end
	end
	if not hitter or hitter.team == nil then return end
	lastPeerTouchAt = stamp
	local attack = attackDirection()
	if not attack then return end
	local playerAttack = hitter.team == me.team and attack or -attack
	local quality = unitValue(vector.dot(impulse, playerAttack) / impulseMagnitude)
	local profile = modeProfile(mode)
	profile.peerTouchSamples += 1
	local touchRate = 1 / math.min(profile.peerTouchSamples, 8)
	profile.peerTouchQuality = unitValue(profile.peerTouchQuality + (quality - profile.peerTouchQuality) * touchRate)
	if not hitter.car.isOnGround then
		profile.peerAerialSamples += 1
		local aerialRate = 1 / math.min(profile.peerAerialSamples, 8)
		profile.peerAerialQuality = unitValue(profile.peerAerialQuality + (quality - profile.peerAerialQuality) * aerialRate)
	end
	learningDirty = true
	if hitter.team ~= me.team or not path or #path == 0 then return end
	local bestReceiver, bestTime, bestDistance, bestScore
	for _, receiver in live.cars do
		if receiver ~= me and receiver ~= hitter and receiver.team == me.team and receiver.car and not receiver.car.isDemoed then
			for _, point in path do
				local t = point.t
				if t >= 0.1 and t <= 2.5 then
					local receiverFuture = receiver.car.body.pos + receiver.car.body.vel * t
					local separation = vector.magnitude(point.pos - receiverFuture)
					local progress = vector.dot(flat(point.pos - ball.pos), attack)
					if progress >= -100 and separation <= receiveRange * 0.75 then
						local score = separation + t * 35
						if not bestScore or score < bestScore then
							bestReceiver, bestTime, bestDistance, bestScore = receiver, t, separation, score
						end
					end
				end
			end
		end
	end
	if bestReceiver and bestTime and bestDistance and bestReceiver.index ~= nil then
		pendingPeerPass = { receiverIndex = bestReceiver.index, expectedTime = bestTime, startedAt = stamp, mode = mode, quality = quality }
	end
end

local function updateLearning()
	if not learningEnabled() or not live or live.source ~= "match" then
		learningTrial, pendingPeerPass, pendingOwnPass, previousPeerBallVelocity = nil, nil, nil, nil
		return
	end
	observeOpponentPressure()
	observePlayerPatterns()
	local current = maneuver or (airActions.passActive and airActions.passLearningAction)
		or (airActions.dribbleActive and airActions.dribbleLearningAction or nil)
	if learningTrial and live.tick < learningTrial.tick then
		learningTrial, pendingPeerPass, pendingOwnPass, previousPeerBallVelocity = nil, nil, nil, nil
	end
	if learningTrial and current ~= learningTrial.maneuver then
		finishLearningTrial(learningTrial)
		learningTrial = nil
	end
	if not learningTrial and current then learningTrial = beginLearningTrial(current) end
	if learningDirty and os.clock() - lastLearningSaveAt >= 30 then
		saveLearning()
		lastLearningSaveAt = os.clock()
	end
end

local origPStep = Prediction and Prediction.step
local origWStep = World and World.step
local wrappedPStep
wrappedPStep = function(self, controls, ...)
	lastMatchAt = os.clock()
	local snapshotOk, snapshot = pcall(fromMatch, self)
	if not snapshotOk then recordRuntimeError("match snapshot", snapshot) end
	live = snapshotOk and snapshot or nil
	if uiReady and snapshotOk and controls and self.match and self.match.phase == "play" then
		if Toggles.PauseAllAssist and Toggles.PauseAllAssist.Value then
			resetControlState()
		else
			local driveOk, driveError = pcall(drive, controls)
			if not driveOk then recordRuntimeError("controls", driveError) end
			if driveOk then
				local reserveOk, reserveError = pcall(applyBoostReserve, controls)
				if not reserveOk then recordRuntimeError("boost reserve", reserveError) end
			end
		end
		if Protocol and type(Protocol.quantize) == "function" then
			local quantizeOk, quantizeError = pcall(Protocol.quantize, controls)
			if not quantizeOk then recordRuntimeError("protocol", quantizeError) end
		end
	end
	if uiReady then
		local learningOk, learningError = pcall(updateLearning)
		if not learningOk then recordRuntimeError("adaptive learning", learningError) end
	end
	if type(origPStep) == "function" then return origPStep(self, controls, ...) end
end
if Prediction and type(origPStep) == "function" then Prediction.step = wrappedPStep end
local wrappedWStep
wrappedWStep = function(self, ...)
	if uiReady and os.clock() - lastMatchAt > 0.25 then
		local menuOk, atMenu = false, false
		if Motion and type(Motion.atMenu) == "function" then menuOk, atMenu = pcall(Motion.atMenu) end
		if menuOk and atMenu then
			live = nil
			resetControlState()
			nx.job = nil
		elseif menuOk then
			local worldOk, worldState = pcall(fromWorld, self)
			if worldOk then
				live = worldState
				local controls = self.car and self.car.controls
				if controls then
					if Toggles.PauseAllAssist and Toggles.PauseAllAssist.Value then
						resetControlState()
					else
						local driveOk, driveError = pcall(drive, controls)
						if not driveOk then recordRuntimeError("world controls", driveError) end
						if driveOk then
							local reserveOk, reserveError = pcall(applyBoostReserve, controls)
							if not reserveOk then recordRuntimeError("boost reserve", reserveError) end
						end
					end
				end
			else
				recordRuntimeError("world snapshot", worldState)
				live = nil
			end
		end
	end
	if type(origWStep) == "function" then return origWStep(self, ...) end
end
if World and type(origWStep) == "function" then World.step = wrappedWStep end

local nextHookCheckAt = 0
local function ensureControlHooks()
	local stamp = os.clock()
	if stamp < nextHookCheckAt then return end
	nextHookCheckAt = stamp + 0.75
	if Prediction and type(Prediction.step) == "function" and Prediction.step ~= wrappedPStep then
		origPStep = Prediction.step
		Prediction.step = wrappedPStep
	end
	if World and type(World.step) == "function" and World.step ~= wrappedWStep then
		origWStep = World.step
		World.step = wrappedWStep
	end
end


function guiFallback.ensureOverlay()
	if guiFallback.gui and guiFallback.gui.Parent then
		guiFallback.gui.Enabled = true
		return true
	end
	local parents = {}
	if type(gethui) == "function" then
		local ok, parent = pcall(gethui)
		if ok and parent then table.insert(parents, parent) end
	end
	local coreOk, core = pcall(function() return game:GetService("CoreGui") end)
	if coreOk and core then table.insert(parents, core) end
	local playerGui = LP and LP:FindFirstChildOfClass("PlayerGui")
	if playerGui then table.insert(parents, playerGui) end
	for _, parent in parents do
		local ok, candidate = pcall(function()
			local gui = Instance.new("ScreenGui")
			gui.Name = "CatwareTurboSoccerOverlay"
			gui.ResetOnSpawn = false
			gui.IgnoreGuiInset = true
			gui.DisplayOrder = 999
			gui.Parent = parent
			return gui
		end)
		if ok and candidate then
			guiFallback.gui = candidate
			guiFallback.texts, guiFallback.lines = {}, {}
			return true
		end
	end
	return false
end


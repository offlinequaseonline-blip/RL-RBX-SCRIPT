local function instantiateRemoteModule(source)
	if type(source) ~= "string" or #source == 0 then return nil end
	local compileOk, chunk = pcall(loadstring, source)
	if not compileOk or type(chunk) ~= "function" then return nil end
	local runOk, result = pcall(chunk)
	return runOk and result or nil
end
local function loadRemoteModule(url, cacheName)
	local cachePath = DIR .. cacheName
	local cachedSource = readText(cachePath)
	local cachedResult = instantiateRemoteModule(cachedSource)
	if cachedResult ~= nil then return cachedResult end
	local requestOk, source = pcall(function() return game:HttpGet(url) end)
	if requestOk and type(source) == "string" then
		local result = instantiateRemoteModule(source)
		if result ~= nil then
			writeText(cachePath, source)
			return result
		end
	end
	return nil
end


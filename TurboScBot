uiFlow.autoAdvanceUi = function()
	if not Toggles.AutoSkipReplay.Value and not Toggles.AutoRematch.Value and not Toggles.AutoDismissRewards.Value
		and not Toggles.AutoExpandRegions.Value and not Toggles.AutoPartyQueue.Value
		and not Toggles.AggressiveTwoGoalMode.Value then return end
	local now = os.clock()
	if now < uiFlow.nextFlowScanAt then return end
	uiFlow.nextFlowScanAt = now + 0.3
	uiFlow.refreshFriendCaches()
	if Toggles.AggressiveTwoGoalMode.Value then
		local scoreGap = uiFlow.scoreGapFromHud()
		aggressiveLeadMode = scoreGap ~= nil and scoreGap >= 2
	else
		aggressiveLeadMode = false
	end
	if Toggles.AutoPartyQueue.Value and uiFlow.friendServerUpdatedAt > 0 then uiFlow.trackFriendsInCurrentMatch() end
	if live and live.phase == "play" then uiFlow.rematchQueued, uiFlow.rematchAttempts = false, 0 end
	if uiFlow.rematchQueued and now - uiFlow.lastRematchClickAt >= 6 then uiFlow.rematchQueued = false end
	local recentMatch = lastMatchAt > 0 and now - lastMatchAt < 180
	local matchStopped = not live or live.source ~= "match" or live.phase ~= "play" or now - lastMatchAt > 1.5
	local postMatch = recentMatch and matchStopped
	local partyTracking = Toggles.AutoPartyQueue.Value
	local trackedFriends = partyTracking and next(uiFlow.trackedPartyFriendIds) ~= nil
	local friendPresent = trackedFriends and uiFlow.trackedFriendIsPresent() or false
	local partyWaiting = false
	if live and live.source == "match" and live.phase == "play" and partyTracking then
		uiFlow.trackFriendsInCurrentMatch()
		trackedFriends = next(uiFlow.trackedPartyFriendIds) ~= nil
		friendPresent = trackedFriends and uiFlow.trackedFriendIsPresent() or false
		if trackedFriends and not friendPresent then
			uiFlow.partyMissingSince = uiFlow.partyMissingSince or now
			if now - uiFlow.partyMissingSince >= 15 then uiFlow.followTrackedFriend() end
		else
			uiFlow.partyMissingSince = nil
		end
	else
		uiFlow.partyMissingSince = nil
	end
	if postMatch and trackedFriends then
		if friendPresent then
			uiFlow.partyWaitSince, uiFlow.partyFriendReturnedAt = nil, uiFlow.partyFriendReturnedAt or now
			partyWaiting = now - uiFlow.partyFriendReturnedAt < 5
		else
			uiFlow.partyFriendReturnedAt = nil
			uiFlow.partyWaitSince = uiFlow.partyWaitSince or now
			partyWaiting = true
			if now - uiFlow.partyWaitSince >= 25 then uiFlow.followTrackedFriend() end
		end
	elseif not postMatch then
		uiFlow.partyWaitSince, uiFlow.partyFriendReturnedAt = nil, nil
	end
	local playerGui = LP:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return end
	local rewardButton, replayButton, rematchButton, regionButton
	for _, item in playerGui:GetDescendants() do
		if item:IsA("GuiButton") and item.Active and uiFlow.guiIsVisible(item, playerGui) then
			local context = uiFlow.buttonContext(item)
			if not regionButton and Toggles.AutoExpandRegions.Value and uiFlow.isYesAction(item) and uiFlow.isMoreRegionsConfirmation(context) then
				regionButton = item
			end
			if postMatch and not rewardButton and Toggles.AutoDismissRewards.Value and uiFlow.isRewardLater(item) then rewardButton = item end
			if not replayButton and Toggles.AutoSkipReplay.Value and uiFlow.isReplaySkip(context) then replayButton = item end
			if postMatch and not rematchButton and Toggles.AutoRematch.Value and uiFlow.isRematch(context, postMatch) then rematchButton = item end
			if rewardButton and replayButton and rematchButton then break end
		end
	end
	if regionButton and now - uiFlow.lastRegionClickAt >= 3 then
		uiFlow.lastRegionClickAt = now
		uiFlow.activateUiButton(regionButton)
		return
	end
	if rewardButton then
		if uiFlow.rewardAttempts < 8 and now - uiFlow.lastRewardClickAt >= 2 then
			uiFlow.lastRewardClickAt = now
			uiFlow.rewardAttempts += 1
			uiFlow.activateUiButton(rewardButton)
		end
		return
	end
	uiFlow.rewardAttempts = 0
	if replayButton then
		if now - uiFlow.lastReplayClickAt >= 1.5 then
			uiFlow.lastReplayClickAt = now
			uiFlow.activateUiButton(replayButton)
		end
		return
	end
	if partyWaiting then return end
	if rematchButton and not uiFlow.rematchQueued and uiFlow.rematchAttempts < 8 and now - uiFlow.lastRematchClickAt >= 3 then
		uiFlow.lastRematchClickAt = now
		uiFlow.rematchAttempts += 1
		uiFlow.rematchQueued = uiFlow.activateUiButton(rematchButton)
	end
end

uiFlow.updateDiagnostics = function()
	local stamp = os.clock()
	if stamp < uiFlow.nextDiagnosticsAt then return end
	uiFlow.nextDiagnosticsAt = stamp + 0.5
	local action, role, eta = "manual", "—", "—"
	if Toggles.PauseAllAssist and Toggles.PauseAllAssist.Value then
		action = "pausado"
	elseif maneuver then
		action = tostring(maneuver.kind)
	elseif Toggles.NextoBot and Toggles.NextoBot.Value then
		action = "Nexto"
	elseif uiReady then
		action = "assistências"
	end
	if live and live.me and live.me.car then
		local st = stateOf(live.me.car)
		local target, interceptTime = bestBallTarget(st)
		if target and interceptTime then
			eta = string.format("%.2fs", interceptTime)
			if detectedTeamSize() == 1 then
				role = "solo"
			else
				local rank = teamInterceptRank(st, target, interceptTime)
				role = rank > 1 and "suporte" or "atacante"
			end
		end
	end
	local samples = 0
	if learningData and learningData.modes then
		local profile = modeProfile(detectedTeamSize())
		if profile and profile.actions then
			samples = (profile.actions.shot.samples or 0) + (profile.actions.pass.samples or 0)
				+ (profile.actions.challenge.samples or 0)
		end
	end
	if uiFlow.statusLabel then
		uiFlow.statusLabel:SetText(string.format("Etapa %s | ação %s | papel %s",
			tostring(sharedEnv.CatwarpZELkorMwhkkpShF5PvT8YnqRCupnLTNG or "desconhecida"), action, role))
	end
	if uiFlow.errorLabel then
		local lastError = tostring(sharedEnv.CatwareTurboSoccerLastError or "nenhum")
		if #lastError > 26 then lastError = lastError:sub(1, 23) .. "..." end
		uiFlow.errorLabel:SetText(string.format("ETA %s | amostras %d | erro %s", eta, samples, lastError))
	end

local queued = false
local function queueTeleport(code)
	local env = getgenv()
	local direct = queue_on_teleport or queueonteleport or env.queue_on_teleport or env.queueonteleport
	if type(direct) == "function" then
		local ok, result = pcall(direct, code)
		if ok and result ~= false then return true end
	end
	local synEnv = env.syn or syn
	if type(synEnv) == "table" and type(synEnv.queue_on_teleport) == "function" then
		local ok, result = pcall(synEnv.queue_on_teleport, code)
		if not ok or result == false then
			ok, result = pcall(synEnv.queue_on_teleport, synEnv, code)
		end
		if ok and result ~= false then return true end
	end
	return false
end
local teleportConn = LP.OnTeleport:Connect(function(state)
	if state == Enum.TeleportState.Started and Toggles.AutoLoad.Value and not queued then
		queued = queueTeleport(LOADER)
	elseif state == Enum.TeleportState.Failed then
		queued = false
	end
end)
local teleportFailedConn = TeleportService.TeleportInitFailed:Connect(function(player)
	if player == LP then queued = false end
end)


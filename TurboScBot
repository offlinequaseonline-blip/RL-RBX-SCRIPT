local function bestBallTarget(st)
	local best, bestDistance, bestTime
	for _, pt in path do
		local carFuture = st.pos + st.vel * pt.t
		local distance = vector.magnitude(pt.pos - carFuture)
		if not bestDistance or distance < bestDistance then
			best, bestDistance, bestTime = pt.pos, distance, pt.t
		end
	end
	return best, bestTime, bestDistance
end

local function startDodge(st, target, kind, full3D)
	if maneuver or not st.isOnGround then return false end
	local dir = target - st.pos
	if not full3D then dir = flat(dir) end
	if vector.magnitude(dir) < 1 then dir = flat(st.rot.forward) end
	if vector.magnitude(dir) < 1 then return false end
	local a = angleTo(st.rot, dir)
	local p, y = -math.cos(a), math.sin(a)
	local m = math.max(math.abs(p), math.abs(y))
	if m < 1e-6 then return false end
	local heading = flat(st.rot.forward)
	if vector.magnitude(heading) < 1 then heading = vector.create(0, 1, 0) end
	maneuver = {
		kind = kind or "flip", t0 = now(), pitch = p / m, yaw = y / m,
		heading = vector.normalize(heading), sawFlip = false,
	}
	return true
end

local function startWaveDash(st, target)
	if maneuver or st.isOnGround or st.isFlipping or st.hasFlipped or st.hasDoubleJumped then return false end
	local dir = flat(target - st.pos)
	if vector.magnitude(dir) < 1 then return false end
	local a = angleTo(st.rot, dir)
	local p, y = -math.cos(a), math.sin(a)
	local m = math.max(math.abs(p), math.abs(y))
	if m < 1e-6 then return false end
	maneuver = { kind = "waveDash", t0 = now(), pitch = p / m, yaw = y / m, released = false }
	return true
end

local function startHalfFlip(st)
	if not startDodge(st, st.pos - st.rot.forward * 100, "halfFlip") then return false end
	maneuver.heading = -maneuver.heading
	return true
end

local function startFastAerial(st, target)
	target = target or bestBallTarget(st)
	if not target or target.z - st.pos.z < Options.AerialHeight.Value or st.boost <= 0 then return false end
	maneuver = { kind = "fastAerial", t0 = now(), target = target, wasAirborne = false }
	return true
end

local function runManeuver(c, st)
	local m = maneuver
	if not m then return false end
	local dt = now() - m.t0
	if dt < 0 then maneuver = nil return false end

	if m.kind == "waveDash" then
		if st.isOnGround or dt > Options.WaveDashDuration.Value then
			maneuver = nil
			c.jump = false
			return true
		end
		if not m.released then
			m.released = true
			c.jump = false
			return true
		end
		c.throttle, c.jump = 1, true
		c.pitch, c.yaw, c.roll = m.pitch, m.yaw, 0
		return true
	end

	if m.kind == "fastAerial" then
		if st.isOnGround and m.wasAirborne then maneuver = nil return false end
		if not st.isOnGround then m.wasAirborne = true end
		local target = bestBallTarget(st)
		if target then m.target = target end
		if dt > 2 or vector.magnitude(m.target - st.pos) < 120 then maneuver = nil return false end
		c.throttle, c.boost = 1, st.boost > 0
		recover(c, st, m.target - st.pos)
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		elseif dt < 0.2 and not st.hasDoubleJumped then
			c.jump = true
		else
			c.jump = false
		end
		return true
	end

	if m.kind == "halfFlip" then
		if dt > 0.9 then maneuver = nil return false end
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		elseif dt < 0.2 then
			c.jump, c.pitch, c.yaw, c.roll = true, m.pitch, m.yaw, 0
		else
			c.jump, c.throttle = false, 1
			recover(c, st, m.heading)
			if st.rot.up.z > 0.75 and vector.dot(flat(st.rot.forward), m.heading) > 0.7 then maneuver = nil end
		end
		return true
	end

	if m.kind == "speedFlip" then
		if dt > 0.9 then maneuver = nil return false end
		c.throttle, c.boost = 1, st.boost > 0
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		elseif dt < 0.2 then
			c.jump, c.pitch, c.yaw, c.roll = true, m.pitch, m.yaw, 0
		else
			c.jump, c.throttle, c.boost = false, 1, st.boost > 0
			c.pitch, c.yaw, c.roll = -m.pitch, m.yaw, 0
			if st.isFlipping then m.sawFlip = true elseif m.sawFlip then maneuver = nil end
		end
		return true
	end

	if m.kind == "flip" or m.kind == "shot" or m.kind == "clear" or m.kind == "flick" or m.kind == "wallShot" then
		if dt > 0.22 then maneuver = nil return false end
		if m.kind == "clear" then c.throttle, c.boost = 1, st.boost > 0 end
		if dt < 0.08 then
			c.jump = true
		elseif dt < 0.13 then
			c.jump = false
		else
			c.jump, c.pitch, c.yaw, c.roll = true, m.pitch, m.yaw, 0
		end
		return true
	end

	maneuver = nil
	return false
end

local function nearBall(st, within)
	local b = path[math.max(1, math.floor(0.15 / (PATH_STRIDE * TICK)))]
	if not b or st.rot.up.z < 0.7 then return nil end
	local d = b.pos - (st.pos + st.vel * 0.15)
	if b.pos.z > 220 or math.abs(d.z) > 200 then return nil end
	local fwd, side = vector.dot(d, st.rot.forward), vector.dot(d, st.rot.right)
	if vector.magnitude(flat(d)) < within and fwd > -40 and math.abs(side) < 130 then return b.pos end
end

local function detectedTeamSize()
	if not live then return 1 end
	local teamCounts = {}
	for _, e in live.cars do
		if e.team ~= nil then teamCounts[e.team] = (teamCounts[e.team] or 0) + 1 end
	end
	local size = 1
	for _, count in teamCounts do size = math.max(size, count) end
	return math.clamp(size, 1, 3)
end

local function teammateCloser(st, target, interceptTime)
	local me = live and live.me
	if not me or me.team == nil then return false end
	local t = interceptTime or 0
	local myFuture = st.pos + st.vel * t
	local myDistance = vector.magnitude(flat(target - myFuture))
	local mode = detectedTeamSize()
	local marginScale = mode == 3 and 1.5 or mode == 2 and 1 or 0
	local margin = Options.TeammateMargin.Value * marginScale
	for _, e in live.cars do
		if e ~= me and e.team == me.team and e.car and not e.car.isDemoed then
			local other = stateOf(e.car)
			local distance = vector.magnitude(flat(target - (other.pos + other.vel * t)))
			if distance + margin < myDistance then return true end
			if math.abs(distance - myDistance) <= margin and e.index ~= nil and me.index ~= nil and e.index < me.index then return true end
		end
	end
	return false
end

local function attackDirection()
	local me = live and live.me
	if not me then return nil end
	local sign = me.team == 0 and 1 or me.team == 1 and -1 or nil
	if not sign then return nil end
	if Toggles.InvertAttackDirection.Value then sign = -sign end
	return vector.create(0, sign, 0)
end


local function waitPath(root, names)
	local node, deadline = root, os.clock() + 15
	for _, name in names do
		if not node then return nil end
		local remaining = deadline - os.clock()
		if remaining <= 0 then return nil end
		local ok, child = pcall(function() return node:WaitForChild(name, remaining) end)
		if not ok or not child then return nil end
		node = child
	end
	return node
end

local function requirePath(root, names)
	local moduleScript = waitPath(root, names)
	if not moduleScript then return nil end
	local ok, result = pcall(require, moduleScript)
	return ok and result or nil
end


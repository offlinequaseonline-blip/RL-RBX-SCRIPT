local function passOpportunity(impact)
	if not Toggles.AutoPass or not Toggles.AutoPass.Value or detectedTeamSize() < 2 then return nil end
	local me = live and live.me
	local attack = attackDirection()
	if not me or me.team == nil or not attack then return nil end
	local profile = modeProfile(detectedTeamSize())
	local minProgress = Options.PassMinProgress.Value - profile.opponentCommitRate * 120
	local maxRange = Options.PassMaxRange.Value
	local clearance = Options.PassLaneClearance.Value
	local bestTarget, bestScore, bestReceiverIndex
	for _, receiver in live.cars do
		if receiver ~= me and receiver.team == me.team and receiver.car and not receiver.car.isDemoed then
			local receiverState = stateOf(receiver.car)
			local receiverLead = profile.ownPassSamples >= 3 and profile.ownPassLead
				or profile.peerPassSamples >= 3 and profile.peerPassLead or Options.PassLeadTime.Value
			local target = receiverState.pos + receiverState.vel * receiverLead
			local route = flat(target - impact)
			local distance = vector.magnitude(route)
			local progress = vector.dot(route, attack)
			if distance >= 220 and distance <= maxRange and progress >= minProgress and progress / distance >= 0.2 then
				local routeLengthSquared = vector.dot(route, route)
				local laneBlocked, receiverOccupied = false, false
				local receiverSpace = math.huge
				local receiverFacing = 0
				local receiverForward = flat(receiverState.rot.forward)
				local receiverToBall = flat(impact - target)
				if vector.magnitude(receiverForward) > 1 and vector.magnitude(receiverToBall) > 1 then
					receiverFacing = vector.dot(vector.normalize(receiverForward), vector.normalize(receiverToBall))
				end
				local receiverMomentum = vector.magnitude(receiverToBall) > 1
					and vector.dot(flat(receiverState.vel), vector.normalize(receiverToBall)) or 0
				for _, opponent in live.cars do
					if opponent ~= me and opponent ~= receiver and opponent.team == me.team and opponent.car and not opponent.car.isDemoed then
						local otherState = stateOf(opponent.car)
						local otherFuture = otherState.pos + otherState.vel * receiverLead
						if vector.magnitude(flat(target - otherFuture)) < clearance then receiverOccupied = true end
					elseif opponent.team ~= nil and opponent.team ~= me.team and opponent.car and not opponent.car.isDemoed then
						local opponentState = stateOf(opponent.car)
						local futureOpponent = opponentState.pos + opponentState.vel * math.min(receiverLead, 0.4)
						local along = math.clamp(vector.dot(flat(futureOpponent - impact), route) / routeLengthSquared, 0, 1)
						local lanePoint = impact + route * along
						if vector.magnitude(flat(futureOpponent - lanePoint)) < clearance then laneBlocked = true end
						receiverSpace = math.min(receiverSpace, vector.magnitude(flat(target - futureOpponent)))
					end
				end
				if not laneBlocked and not receiverOccupied then
					local score = progress - distance * 0.18 + math.min(receiverSpace, 500) * 0.12
						+ receiverFacing * 90 + math.clamp(receiverMomentum, -500, 500) * 0.08
					if not bestScore or score > bestScore then bestTarget, bestScore, bestReceiverIndex = target, score, receiver.index end
				end
			end
		end
	end
	return bestTarget, bestReceiverIndex
end

local function shotLaneBlocked(impact, attack)
	local me = live and live.me
	if not me or not attack then return false end
	for _, entry in live.cars do
		if entry ~= me and entry.team ~= nil and entry.team ~= me.team and entry.car and not entry.car.isDemoed then
			local other = stateOf(entry.car)
			local future = flat(other.pos + other.vel * 0.35 - impact)
			local along = vector.dot(future, attack)
			if along > 100 and along <= Options.ShotLaneRange.Value then
				local lateral = vector.magnitude(future - attack * along)
				if lateral <= Options.ShotLaneClearance.Value then return true end
			end
		end
	end
	return false
end

local function applyShotApproachControls(c, st, intercept, interceptDistance)
	if maneuver or not Toggles.AutoStrike.Value or not st.isOnGround or not intercept or not attackDirection() then return false end
	if not interceptDistance or interceptDistance > 500 then return false end
	local attack = attackDirection()
	if shotLaneBlocked(intercept, attack) then return false end
	local forward = flat(st.rot.forward)
	if vector.magnitude(forward) < 0.01 then return false end
	local alignment = vector.dot(vector.normalize(forward), attack)
	if alignment >= 0.72 then return false end
	local setup = flat(intercept) - attack * Options.ShotApproachOffset.Value
	local direction = flat(setup - st.pos)
	local distance = vector.magnitude(direction)
	if distance < 90 or distance > 360 then return false end
	local angle = angleTo(st.rot, direction)
	c.throttle = math.clamp(distance / 300, 0.25, 0.75)
	c.steer = clamp1(angle / (math.pi / 2))
	c.jump = false
	c.boost = st.boost > 25 and distance > 280 and math.abs(angle) < 0.25
	c.handbrake = shouldPowerSlide(st, angle, distance)
	return true
end

local function strikeOpportunity(st)
	local ball = live and live.ball and live.ball.body
	local attack = attackDirection()
	local impact = nearBall(st, Options.FlipRange.Value)
	if not ball or not attack or not impact then return nil end
	local fwd, side = vector.dot(impact - (st.pos + st.vel * 0.15), st.rot.forward),
		vector.dot(impact - (st.pos + st.vel * 0.15), st.rot.right)
	local forward = flat(st.rot.forward)
	if fwd <= 0 or math.abs(side) > Options.ShotLineTolerance.Value or vector.magnitude(forward) < 1 then return nil end
	local alignment = vector.dot(vector.normalize(forward), attack)
	local progress = vector.dot(impact, attack)
	local incoming = vector.dot(ball.vel, attack) < -Options.ClearIncomingSpeed.Value
	if Toggles.AutoStrike.Value and progress < -Options.ClearDepth.Value and incoming then return impact, attack, "clear" end
	local passTarget, passReceiverIndex = passOpportunity(impact)
	if passTarget then
		local profile = modeProfile(detectedTeamSize())
		local passMetric = profile.actions.pass
		local passThreshold = Options.PassShotThreshold.Value - profile.opponentCommitRate * 0.1
		if passMetric.samples >= 3 then passThreshold -= passMetric.average * 0.08 end
		local ownPassOutcomes = profile.ownPassSamples + profile.ownPassMisses
		if ownPassOutcomes >= 3 then
			passThreshold += profile.ownPassQuality * 0.08
			passThreshold -= profile.ownPassMisses / ownPassOutcomes * 0.06
		end
		local peerPassOutcomes = profile.peerPassSamples + profile.peerPassMisses
		if peerPassOutcomes >= 3 then
			passThreshold += profile.peerPassQuality * 0.04
			passThreshold -= profile.peerPassMisses / peerPassOutcomes * 0.03
		end
		passThreshold = math.clamp(math.min(passThreshold, 0.68), 0.3, 0.68)
		local blocked = shotLaneBlocked(impact, attack)
		if blocked or alignment < passThreshold then return impact, nil, "pass", passTarget, passReceiverIndex end
	end
	local blocked = shotLaneBlocked(impact, attack)
	local shotThreshold = math.clamp(math.min(adaptiveShotAlignment(), 0.72), 0.55, 0.72)
	if Toggles.AutoStrike.Value and alignment >= shotThreshold and (not blocked or not passTarget) then
		return impact, attack, "shot"
	end
	return nil
end

local function flickTarget(st)
	local _, attack, kind, passTarget, passReceiverIndex = strikeOpportunity(st)
	if kind == "pass" and passTarget then return passTarget, "pass", passReceiverIndex end
	if (kind == "shot" or kind == "clear") and attack then return st.pos + attack * 100, "flick" end
	local forward = flat(st.rot.forward)
	local goal = attackDirection()
	if goal and vector.magnitude(forward) > 1 and vector.dot(vector.normalize(forward), goal) > 0.7 then
		return st.pos + goal * 100, "flick"
	end
	if vector.magnitude(forward) > 1 then return st.pos + forward * 100, "flick" end
	return nil
end

local function dribbleSetup(st)
	local ball = live and live.ball and live.ball.body
	if not ball or not st.isOnGround or st.rot.up.z < 0.7 then return false end
	local relative = ball.pos - st.pos
	local front = vector.dot(relative, st.rot.forward)
	local side = vector.dot(relative, st.rot.right)
	local height = vector.dot(relative, st.rot.up)
	local relativeSpeed = vector.magnitude(ball.vel - st.vel)
	return front >= 0 and front <= Options.FlickFrontMax.Value
		and math.abs(side) <= Options.FlickSideMax.Value
		and height >= Options.FlickHeightMin.Value and height <= Options.FlickHeightMax.Value
		and relativeSpeed <= Options.FlickRelativeSpeed.Value
end

local function timeToGround(st)
	local height = st.pos.z - Options.WaveDashGroundZ.Value
	if height <= 0 then return 0 end
	local gravity = Options.WaveDashGravity.Value
	local discriminant = st.vel.z * st.vel.z + 2 * gravity * height
	return (st.vel.z + math.sqrt(discriminant)) / gravity
end

local function wallShotOpportunity(st)
	if not st.isOnGround or st.rot.up.z <= -0.7 or st.rot.up.z >= 0.7 then return nil end
	local ball = live and live.ball and live.ball.body
	if not ball then return nil end
	local relative = ball.pos - (st.pos + st.vel * 0.1)
	local forward = vector.dot(relative, st.rot.forward)
	local side = vector.dot(relative, st.rot.right)
	if forward <= 0 or math.abs(side) > Options.WallShotSide.Value
		or vector.magnitude(relative) > Options.WallShotRange.Value then return nil end
	local target = st.pos + st.rot.forward * forward + st.rot.right * side
	return target
end

local function demoThreat(st)
	if not Toggles.AutoDemoEvade or not Options.DemoEvadeRadius or not Toggles.AutoDemoEvade.Value
		or not st.isOnGround or st.rot.up.z < 0.7 or not live or not live.me then return nil end
	local me = live.me
	local best
	local radius = Options.DemoEvadeRadius.Value
	for _, entry in live.cars do
		if entry ~= me and entry.team ~= me.team and entry.car and not entry.car.isDemoed then
			local other = stateOf(entry.car)
			local relativePosition = flat(other.pos - st.pos)
			local relativeVelocity = flat(other.vel - st.vel)
			local speedSquared = vector.dot(relativeVelocity, relativeVelocity)
			if speedSquared > 1 and vector.dot(relativePosition, relativeVelocity) < 0 then
				local impactTime = math.clamp(-vector.dot(relativePosition, relativeVelocity) / speedSquared, 0, 0.55)
				local missDistance = vector.magnitude(relativePosition + relativeVelocity * impactTime)
				if missDistance <= radius and (not best or impactTime < best.time) then
					best = { time = impactTime, side = vector.dot(relativePosition, st.rot.right), id = entry.index }
				end
			end
		end
	end
	return best
end

local boostRouteTarget
local function boostPadTarget(st)
	local threshold = Options.BoostRouteThreshold
	local ballBuffer = Options.BoostRouteBallBuffer
	local maxRange = Options.BoostRouteMaxRange
	if not Toggles.AutoBoostRoute or not Toggles.AutoBoostRoute.Value or not live
		or not threshold or not ballBuffer or not maxRange
		or not st.isOnGround or st.rot.up.z < 0.7 or st.boost >= threshold.Value then return nil end
	local ball = live.ball and live.ball.body
	if not ball or vector.magnitude(flat(ball.pos - st.pos)) < ballBuffer.Value then return nil end
	local best, bestScore
	for _, pad in live.pads do
		local pos = pad.pos
		if pad.isActive and pos then
			local direction = flat(pos - st.pos)
			local distance = vector.magnitude(direction)
			if distance >= 90 and distance <= maxRange.Value then
				local turn = math.abs(angleTo(st.rot, direction))
				local largePad = pos.z > 72
				local score = distance + turn * 180 - (largePad and 250 or 0)
				if not bestScore or score < bestScore then best, bestScore = pos, score end
			end
		end
	end
	return best
end

local function routeToBoostPad(c, st)
	boostRouteTarget = nil
	if Toggles.NextoBot.Value then return false end
	local target = boostPadTarget(st)
	if not target then return false end
	local direction = flat(target - st.pos)
	local distance = vector.magnitude(direction)
	if distance < 1 then return false end
	local angle = angleTo(st.rot, direction)
	boostRouteTarget = target
	c.throttle = 1
	c.steer = clamp1(angle / (math.pi / 2))
	c.boost = st.boost > 0 and distance > 250 and math.abs(angle) < 0.45
	c.jump = false
	c.handbrake = shouldPowerSlide(st, angle, distance)
	return true
end


uiFlow.isRewardLater = function(button)
	local function matches(value, isName)
		local label = tostring(value or ""):lower():gsub("[%s%p_]+", "")
		if uiFlow.rewardLaterLabels[label] then return true end
		if isName then
			for phrase in uiFlow.rewardLaterLabels do
				if label:find(phrase, 1, true) then return true end
			end
		end
		return false
	end
	if matches(button.Name, true) then return true end
	if button:IsA("TextButton") and matches(button.Text, false) then return true end
	for _, child in button:GetDescendants() do
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			if matches(child.Name, true) or matches(child.Text, false) then return true end
		end
	end
	return false
end

uiFlow.fireButtonSignal = function(signal, inputObject, clickCount)
	if type(getconnections) ~= "function" then return false end
	local ok, connections = pcall(getconnections, signal)
	if not ok or type(connections) ~= "table" then return false end
	local hasEnabled = false
	for _, connection in connections do
		if connection.Enabled ~= false and type(connection.Fire) == "function" then hasEnabled = true break end
	end
	if not hasEnabled then return false end
	if type(firesignal) == "function" then
		local fired = pcall(firesignal, signal, inputObject, clickCount)
		if not fired then fired = pcall(firesignal, signal) end
		if fired then return true end
	end
	local fired = false
	for _, connection in connections do
		local didFire = pcall(function()
			if connection.Enabled == false or type(connection.Fire) ~= "function" then return end
			connection:Fire(inputObject, clickCount)
		end)
		fired = fired or didFire
	end
	return fired
end

uiFlow.physicalButtonClick = function(button)
	if type(isrbxactive) ~= "function" or type(mousemoveabs) ~= "function" or type(mouse1click) ~= "function" then return false end
	local focusOk, focused = pcall(isrbxactive)
	if not focusOk or not focused then return false end
	local position = button.AbsolutePosition + button.AbsoluteSize / 2
	local insetOk, topLeftInset = pcall(function() return GuiService:GetGuiInset() end)
	if insetOk then position += topLeftInset end
	local camera = workspace.CurrentCamera
	if camera and (position.X < 0 or position.Y < 0 or position.X >= camera.ViewportSize.X or position.Y >= camera.ViewportSize.Y) then return false end
	local ok = pcall(function()
		mousemoveabs(math.floor(position.X), math.floor(position.Y))
		task.wait(0.05)
		mouse1click()
	end)
	return ok
end


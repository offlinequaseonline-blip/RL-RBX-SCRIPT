local function screen(uu)
	cam = workspace.CurrentCamera or cam
	if not cam then return Vector2.zero, false end
	local v, on = cam:WorldToViewportPoint(Units.pos(uu))
	return Vector2.new(v.X, v.Y), on
end

local function draw()
	local n = 0
	landing.Visible = false
	boostMarker.Visible = false
	if Toggles.BallPath.Value and #path > 1 then
		local col = Options.PathColor.Value
		local prev, prevOn = screen(live.ball.body.pos)
		for _, pt in path do
			local s, on = screen(pt.pos)
			if on and prevOn then
				n += 1
				local l = line(n)
				l.From, l.To, l.Color, l.Visible = prev, s, col, true
			end
			prev, prevOn = s, on
		end
		for _, pt in path do
			if pt.pos.z < 110 then
				local s, on = screen(pt.pos)
				if on then
					landing.Position, landing.Radius, landing.Color, landing.Visible = s, 12, col, true
				end
				break
			end
		end
	end
	if boostRouteTarget and live and Toggles.AutoBoostRoute.Value then
		local point, onScreen = screen(boostRouteTarget)
		if onScreen then
			boostMarker.Position, boostMarker.Radius = point, 15
			boostMarker.Color, boostMarker.Visible = Color3.fromRGB(85, 230, 155), true
		end
	end
	for i = n + 1, #lines do lines[i].Visible = false end

	local m = 0
	local me = live and live.me
	if Toggles.BoostESP.Value and live then
		for _, e in live.cars do
			if e ~= me and not e.car.isDemoed then
				local s, on = screen(e.car.body.pos + vector.create(0, 0, 90))
				if on then
					m += 1
					local t = text(m)
					local allied = me and e.team == me.team
					t.Text = string.format("%s %d", allied and "TIME" or "RIVAL", math.floor(e.car.boost))
					t.Color = allied and Color3.fromRGB(90, 170, 255) or Color3.fromRGB(255, 110, 60)
					t.Position, t.Visible = s, true
				end
			end
		end
	end
	for i = m + 1, #texts do texts[i].Visible = false end
end

local nextFlowScanAt, lastReplayClickAt, lastRematchClickAt, lastRewardClickAt = 0, 0, 0, 0
local rematchQueued, rematchAttempts, rewardAttempts = false, 0, 0
local function guiIsVisible(button, root)
	local node = button
	while node and node ~= root do
		if node:IsA("GuiObject") and not node.Visible then return false end
		if node:IsA("ScreenGui") and not node.Enabled then return false end
		node = node.Parent
	end
	return node == root
end

local function buttonContext(button)
	local parts = { button.Name }
	if button:IsA("TextButton") then table.insert(parts, button.Text) end
	for _, child in button:GetDescendants() do
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			table.insert(parts, child.Name)
			table.insert(parts, child.Text)
		end
	end
	local node = button.Parent
	local depth = 0
	while node and depth < 6 do
		table.insert(parts, node.Name)
		if node:IsA("TextLabel") or node:IsA("TextButton") then table.insert(parts, node.Text) end
		node = node.Parent
		depth += 1
	end
	local lower = string.lower(table.concat(parts, " "))
	return lower:gsub("[%s%p_]+", "")
end

local function isReplaySkip(context)
	local replay = context:find("replay", 1, true) or context:find("repeticao", 1, true) or context:find("repetição", 1, true)
	local skip = context:find("skip", 1, true) or context:find("pular", 1, true) or context:find("saltar", 1, true)
	local continue = context:find("continue", 1, true) or context:find("continuar", 1, true)
	return replay ~= nil and (skip ~= nil or continue ~= nil)
end

local function isRematch(context, postMatch)
	local phrases = {
		"rematch", "playagain", "requeue", "queueagain", "jogarnovamente",
		"jogardenovo", "jogaroutrapartida", "jogaroutrajogo", "novapartida",
		"partidanova", "revanche",
	}
	for _, phrase in phrases do
		if context:find(phrase, 1, true) then return true end
	end
	local continuation = context:find("continue", 1, true) or context:find("continuar", 1, true)
	if continuation and postMatch then return true end
	return false
end

local rewardLaterLabels = {
	depois = true, maistarde = true, later = true, notnow = true, skipfornow = true,
	agoranaon = true, ["agoranão"] = true,
}

local function isRewardLater(button)
	local function matches(value, isName)
		local label = tostring(value or ""):lower():gsub("[%s%p_]+", "")
		if rewardLaterLabels[label] then return true end
		if isName then
			for phrase in rewardLaterLabels do
				if label:find(phrase, 1, true) then return true end
			end
		end
		return false
	end
	if matches(button.Name, true) then return true end
	if button:IsA("TextButton") and matches(button.Text, false) then return true end
	for _, child in button:GetDescendants() do
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			if matches(child.Name, true) or matches(child.Text, false) then return true end
		end
	end
	return false
end

local function fireButtonSignal(signal, inputObject, clickCount)
	if type(getconnections) ~= "function" then return false end
	local ok, connections = pcall(getconnections, signal)
	if not ok or type(connections) ~= "table" then return false end
	local hasEnabled = false
	for _, connection in connections do
		if connection.Enabled ~= false and type(connection.Fire) == "function" then hasEnabled = true break end
	end
	if not hasEnabled then return false end
	if type(firesignal) == "function" then
		local fired = pcall(firesignal, signal, inputObject, clickCount)
		if not fired then fired = pcall(firesignal, signal) end
		if fired then return true end
	end
	local fired = false
	for _, connection in connections do
		local didFire = pcall(function()
			if connection.Enabled == false or type(connection.Fire) ~= "function" then return end
			connection:Fire(inputObject, clickCount)
		end)
		fired = fired or didFire
	end
	return fired
end

local function physicalButtonClick(button)
	if type(isrbxactive) ~= "function" or type(mousemoveabs) ~= "function" or type(mouse1click) ~= "function" then return false end
	local focusOk, focused = pcall(isrbxactive)
	if not focusOk or not focused then return false end
	local position = button.AbsolutePosition + button.AbsoluteSize / 2
	local insetOk, topLeftInset = pcall(function() return GuiService:GetGuiInset() end)
	if insetOk then position += topLeftInset end
	local camera = workspace.CurrentCamera
	if camera and (position.X < 0 or position.Y < 0 or position.X >= camera.ViewportSize.X or position.Y >= camera.ViewportSize.Y) then return false end
	local ok = pcall(function()
		mousemoveabs(math.floor(position.X), math.floor(position.Y))
		task.wait(0.05)
		mouse1click()
	end)
	return ok
end

local function activateUiButton(button)
	if fireButtonSignal(button.Activated, nil, 0) then return true end
	if fireButtonSignal(button.MouseButton1Click) then return true end
	return physicalButtonClick(button)
end

local function autoAdvanceUi()
	if not Toggles.AutoSkipReplay.Value and not Toggles.AutoRematch.Value and not Toggles.AutoDismissRewards.Value then return end
	local now = os.clock()
	if now < nextFlowScanAt then return end
	nextFlowScanAt = now + 0.3
	if live and live.phase == "play" then rematchQueued, rematchAttempts = false, 0 end
	if rematchQueued and now - lastRematchClickAt >= 6 then rematchQueued = false end
	local recentMatch = lastMatchAt > 0 and now - lastMatchAt < 180
	local matchStopped = not live or live.source ~= "match" or live.phase ~= "play" or now - lastMatchAt > 1.5
	local postMatch = recentMatch and matchStopped
	local playerGui = LP:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return end
	local rewardButton, replayButton, rematchButton
	for _, item in playerGui:GetDescendants() do
		if item:IsA("GuiButton") and item.Active and guiIsVisible(item, playerGui) then
			local context = buttonContext(item)
			if postMatch and not rewardButton and Toggles.AutoDismissRewards.Value and isRewardLater(item) then rewardButton = item end
			if not replayButton and Toggles.AutoSkipReplay.Value and isReplaySkip(context) then replayButton = item end
			if postMatch and not rematchButton and Toggles.AutoRematch.Value and isRematch(context, postMatch) then rematchButton = item end
			if rewardButton and replayButton and rematchButton then break end
		end
	end
	if rewardButton then
		if rewardAttempts < 8 and now - lastRewardClickAt >= 2 then
			lastRewardClickAt = now
			rewardAttempts += 1
			activateUiButton(rewardButton)
		end
		return
	end
	rewardAttempts = 0
	if replayButton then
		if now - lastReplayClickAt >= 1.5 then
			lastReplayClickAt = now
			activateUiButton(replayButton)
		end
		return
	end
	if rematchButton and not rematchQueued and rematchAttempts < 8 and now - lastRematchClickAt >= 3 then
		lastRematchClickAt = now
		rematchAttempts += 1
		rematchQueued = activateUiButton(rematchButton)
	end
end

